<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\PDFBlender.Core\PDFBlender.Core.csproj" />
    <ProjectReference Include="..\PDFBlender.Pdf\PDFBlender.Pdf.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationIcon>Assets\logo.ico</ApplicationIcon>
    <AssemblyTitle>PDF Blender</AssemblyTitle>
    <Description>PDF Blender</Description>
    <Product>PDF Blender</Product>
    <Copyright>Copyright © 2016-2026 BITCOOKIES</Copyright>
  </PropertyGroup>

  <ItemGroup>
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\logo.png" />
    <Resource Include="Assets\logo.ico" />
    <Resource Include="..\..\assets\banner.png" Link="Assets\banner.png" />
    <Resource Include="..\..\assets\pdf-icon.png" Link="Assets\pdf-icon.png" />
    <Resource Include="..\..\assets\bitcookies-words.png" Link="Assets\bitcookies-words.png" />
    <Content Include="..\..\assets\sounds\toast-1.mp3" Link="Assets\sounds\toast-1.mp3" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\..\assets\sounds\toast-2.mp3" Link="Assets\sounds\toast-2.mp3" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\..\assets\sounds\toast-3.mp3" Link="Assets\sounds\toast-3.mp3" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\..\assets\sounds\toast-4.mp3" Link="Assets\sounds\toast-4.mp3" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\..\assets\sounds\toast-5.mp3" Link="Assets\sounds\toast-5.mp3" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="WPF-UI" Version="4.3.0" />
  </ItemGroup>

</Project>
