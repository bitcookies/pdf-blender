<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <ControlTemplate x:Key="BlenderNavigationItemTemplate" TargetType="ui:NavigationViewItem">
        <Grid Margin="2,2">
            <Border x:Name="ItemSurface"
                    MinHeight="48"
                    Background="Transparent"
                    BorderBrush="Transparent"
                    BorderThickness="0"
                    CornerRadius="8"
                    Padding="10,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="28" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <ContentPresenter Grid.Column="0"
                                      ContentSource="Icon"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"
                                      TextElement.Foreground="{TemplateBinding Foreground}" />
                    <ContentPresenter Grid.Column="1"
                                      ContentSource="Content"
                                      Margin="10,0,0,0"
                                      VerticalAlignment="Center"
                                      RecognizesAccessKey="True"
                                      TextElement.Foreground="{TemplateBinding Foreground}" />
                </Grid>
            </Border>
            <Border x:Name="ActiveIndicator"
                    Width="3"
                    Height="24"
                    Margin="0,0,0,0"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    CornerRadius="1.5"
                    Background="{DynamicResource NavigationViewSelectionIndicatorForeground}"
                    Visibility="Collapsed" />
        </Grid>
        <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="ItemSurface" Property="Background" Value="{DynamicResource NavigationViewItemBackgroundPointerOverLeftFluent}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="ItemSurface" Property="Background" Value="{DynamicResource NavigationViewItemBackgroundPressed}" />
            </Trigger>
            <Trigger Property="IsActive" Value="True">
                <Setter TargetName="ItemSurface" Property="Background" Value="{DynamicResource NavigationViewItemBackgroundSelectedLeftFluent}" />
                <Setter TargetName="ActiveIndicator" Property="Visibility" Value="Visible" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="ItemSurface" Property="Opacity" Value="0.5" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <Style x:Key="BlenderNavigationItemStyle"
           TargetType="ui:NavigationViewItem"
           BasedOn="{StaticResource {x:Type ui:NavigationViewItem}}">
        <Setter Property="Template" Value="{StaticResource BlenderNavigationItemTemplate}" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="Foreground" Value="{DynamicResource NavigationViewItemForeground}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Margin" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource NavigationViewItemForegroundPointerOverLeftFluent}" />
            </Trigger>
            <Trigger Property="IsActive" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource NavigationViewItemForegroundLeftFluent}" />
            </Trigger>
        </Style.Triggers>
    </Style>
</ResourceDictionary>
