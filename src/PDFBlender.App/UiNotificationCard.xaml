<UserControl x:Class="PDFBlender.App.UiNotificationCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             Width="340" MinHeight="72" Focusable="False"
             MouseEnter="CardMouseEnter" MouseLeave="CardMouseLeave">
    <Border x:Name="CardBorder" Background="{DynamicResource NotificationBrush}" BorderBrush="{DynamicResource NotificationBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="11,10" Effect="{DynamicResource FlyoutShadowEffect}">
        <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="3" /><ColumnDefinition Width="30" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <Border x:Name="IntentBar" Width="3" Margin="0,2,0,2" CornerRadius="1.5" Background="{DynamicResource NotificationMessageBrush}" />
            <ui:SymbolIcon x:Name="IntentIcon" Grid.Column="1" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0" Foreground="{DynamicResource NotificationMessageBrush}" />
            <StackPanel Grid.Column="2" Margin="2,0,8,0" VerticalAlignment="Center">
                <TextBlock x:Name="TitleText" FontSize="13.5" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" TextTrimming="CharacterEllipsis" />
                <TextBlock x:Name="MessageText" FontSize="12.5" Foreground="{DynamicResource MutedTextBrush}" TextWrapping="Wrap" MaxHeight="38" Margin="0,2,0,0" />
                <ProgressBar x:Name="NotificationProgress" Height="3" Margin="0,8,0,0" Minimum="0" Maximum="100" BorderThickness="0" Foreground="{DynamicResource AccentBrush}" Background="{DynamicResource SurfaceRaisedBrush}" Visibility="Collapsed" />
            </StackPanel>
            <Button x:Name="CloseButton" Grid.Column="3" Width="26" Height="26" Padding="0" Background="Transparent" BorderThickness="0" VerticalAlignment="Top" Click="CloseButton_Click" ToolTip="Close" FocusVisualStyle="{x:Null}">
                <ui:SymbolIcon Symbol="Dismiss16" FontSize="15" Foreground="{DynamicResource MutedTextBrush}" />
            </Button>
        </Grid>
    </Border>
</UserControl>
