<UserControl x:Class="PDFBlender.App.BlendLevelRail"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             MinHeight="116"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">
    <UserControl.Resources>
        <TranslateTransform x:Key="RailContentOffset" Y="20" />
        <Style x:Key="RailRepeatButtonStyle" TargetType="RepeatButton">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="IsTabStop" Value="False" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Border Background="{TemplateBinding Background}" BorderThickness="0" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="Transparent" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="Transparent" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="BlendSliderStyle" TargetType="Slider">
            <Setter Property="Height" Value="42" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid Height="42" ClipToBounds="False">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="10*" />
                                <ColumnDefinition Width="80*" />
                                <ColumnDefinition Width="10*" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="1"
                                    Height="18"
                                    Margin="-15,0"
                                    Background="{DynamicResource BorderBrush}"
                                    CornerRadius="9"
                                    VerticalAlignment="Center" />
                            <Track x:Name="PART_Track"
                                   Grid.Column="1"
                                   Height="42"
                                   Margin="-15,0"
                                   ClipToBounds="False"
                                   IsDirectionReversed="{TemplateBinding IsDirectionReversed}"
                                   VerticalAlignment="Center"
                                   HorizontalAlignment="Stretch">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="{x:Static Slider.DecreaseLarge}"
                                                  Style="{StaticResource RailRepeatButtonStyle}" />
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Width="30"
                                           Height="30"
                                           FocusVisualStyle="{x:Null}">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border x:Name="ThumbBorder"
                                                        Background="White"
                                                        BorderBrush="#E6E6E6"
                                                        BorderThickness="1"
                                                        CornerRadius="15" />
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="ThumbBorder" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                                    </Trigger>
                                                    <Trigger Property="IsDragging" Value="True">
                                                        <Setter TargetName="ThumbBorder" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                                    </Trigger>
                                                    <Trigger Property="IsEnabled" Value="False">
                                                        <Setter TargetName="ThumbBorder" Property="Background" Value="{DynamicResource SurfaceMutedBrush}" />
                                                        <Setter TargetName="ThumbBorder" Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="{x:Static Slider.IncreaseLarge}"
                                                  Style="{StaticResource RailRepeatButtonStyle}" />
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Height="116" VerticalAlignment="Top" ClipToBounds="False">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="72" />
            <ColumnDefinition Width="54" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="18" />
            <RowDefinition Height="16" />
            <RowDefinition Height="6" />
            <RowDefinition Height="42" />
            <RowDefinition Height="6" />
            <RowDefinition Height="18" />
        </Grid.RowDefinitions>

        <TextBlock x:Name="CaptionText"
                   Grid.Row="0"
                   Grid.Column="0"
                   FontSize="14"
                   FontWeight="SemiBold"
                   Foreground="{DynamicResource TextBrush}"
                   VerticalAlignment="Center" />

        <Canvas x:Name="NumbersPanel"
                     Grid.Row="1"
                     Grid.Column="0"
                     Height="16"
                     RenderTransform="{StaticResource RailContentOffset}"
                     IsHitTestVisible="False"
                     SizeChanged="RailPanel_SizeChanged" />
        <Canvas x:Name="UpperTickPanel"
                     Grid.Row="2"
                     Grid.Column="0"
                     Height="6"
                     RenderTransform="{StaticResource RailContentOffset}"
                     IsHitTestVisible="False"
                     SizeChanged="RailPanel_SizeChanged" />
        <Slider x:Name="LevelSlider"
                Cursor="Hand"
                Grid.Row="3"
                Grid.Column="0"
                Style="{StaticResource BlendSliderStyle}"
                ClipToBounds="False"
                RenderTransform="{StaticResource RailContentOffset}"
                Minimum="0"
                Maximum="4"
                TickFrequency="1"
                IsSnapToTickEnabled="True"
                VerticalAlignment="Center"
                AutomationProperties.Name="Blend level"
                ValueChanged="LevelSlider_ValueChanged" />
        <Canvas x:Name="LowerTickPanel"
                     Grid.Row="4"
                     Grid.Column="0"
                     Height="6"
                     RenderTransform="{StaticResource RailContentOffset}"
                     IsHitTestVisible="False"
                     SizeChanged="RailPanel_SizeChanged" />
        <Canvas x:Name="LabelsPanel"
                     Grid.Row="5"
                     Grid.Column="0"
                     Height="18"
                     RenderTransform="{StaticResource RailContentOffset}"
                     IsHitTestVisible="False"
                     SizeChanged="RailPanel_SizeChanged" />

        <Border x:Name="IntensityPill"
                Grid.Row="3"
                Grid.Column="1"
                Width="68"
                Height="32"
                HorizontalAlignment="Left"
                Margin="-16,0,0,0"
                RenderTransform="{StaticResource RailContentOffset}"
                VerticalAlignment="Center"
                Background="{DynamicResource CardBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="16"
                Padding="8,0">
            <TextBlock x:Name="IntensityText"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       TextAlignment="Center"
                       FontSize="11"
                       Foreground="{DynamicResource MutedTextBrush}"
                       TextTrimming="CharacterEllipsis" />
        </Border>

        <ui:Button x:Name="EditButton"
                   Grid.Row="1"
                   Grid.RowSpan="5"
                   Grid.Column="2"
                   Width="48"
                   Height="48"
                   Padding="0"
                   CornerRadius="24"
                   Background="White"
                   BorderBrush="{DynamicResource BorderBrush}"
                   BorderThickness="1"
                   Appearance="Transparent"
                   FocusVisualStyle="{x:Null}"
                   RenderTransform="{StaticResource RailContentOffset}"
                   HorizontalContentAlignment="Center"
                   VerticalContentAlignment="Center"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   Click="EditButton_Click"
                   ToolTip="Edit blend configurations"
                   AutomationProperties.Name="Edit blend configurations">
            <ui:SymbolIcon Symbol="Options24" FontSize="18" Foreground="{DynamicResource AccentBrush}" />
        </ui:Button>
    </Grid>
</UserControl>
