<Window x:Class="PDFBlender.App.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PDF Blender"
        Icon="/PDFBlender.App;component/Assets/logo.ico"
        Width="540"
        Height="700"
        MinWidth="480"
        MinHeight="600"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBackgroundBrush}">
    <Grid Margin="24,20,24,18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock x:Name="TitleText" FontSize="20" FontWeight="SemiBold" />
            <TextBlock x:Name="SubtitleText" Margin="0,4,0,0" Foreground="{DynamicResource MutedTextBrush}" FontSize="12" />
        </StackPanel>

        <ScrollViewer Grid.Row="1" Margin="0,18,0,16" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock x:Name="AppearanceHeader" FontSize="14" FontWeight="SemiBold" />
                <TextBlock x:Name="ThemeLabel" Margin="0,10,0,5" Foreground="{DynamicResource MutedTextBrush}" FontSize="11" />
                <ListBox x:Name="ThemeOptions"
                         Style="{StaticResource SegmentedListBoxStyle}"
                         ItemContainerStyle="{StaticResource SegmentedListBoxItemStyle}"
                         SelectionMode="Single">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="3" />
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                </ListBox>
                <TextBlock x:Name="LanguageLabel" Margin="0,12,0,5" Foreground="{DynamicResource MutedTextBrush}" FontSize="11" />
                <ListBox x:Name="LanguageOptions"
                         Style="{StaticResource SegmentedListBoxStyle}"
                         ItemContainerStyle="{StaticResource SegmentedListBoxItemStyle}"
                         SelectionMode="Single">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="3" />
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                </ListBox>

                <Separator Margin="0,18,0,16" />
                <TextBlock x:Name="FormatHeader" FontSize="14" FontWeight="SemiBold" />
                <CheckBox x:Name="NormalizeWidthCheck" Margin="0,10,0,6" Style="{StaticResource CompactCheckBoxStyle}" />
                <TextBlock x:Name="TargetWidthLabel" Foreground="{DynamicResource MutedTextBrush}" FontSize="11" />
                <TextBox x:Name="TargetWidthText" Margin="0,5,0,4" />
                <TextBlock x:Name="TargetWidthHint" Foreground="{DynamicResource MutedTextBrush}" FontSize="11" TextWrapping="Wrap" />

                <Separator Margin="0,18,0,16" />
                <TextBlock x:Name="ProtectionHeader" FontSize="14" FontWeight="SemiBold" />
                <ComboBox x:Name="ProtectionCombo" Margin="0,10,0,0" />

                <Separator Margin="0,18,0,16" />
                <TextBlock x:Name="WatermarkHeader" FontSize="14" FontWeight="SemiBold" />
                <ComboBox x:Name="WatermarkCombo" Margin="0,10,0,0" />
                <TextBlock x:Name="WatermarkTextLabel" Margin="0,10,0,5" Foreground="{DynamicResource MutedTextBrush}" FontSize="11" />
                <TextBox x:Name="WatermarkTextBox" />

                <Separator Margin="0,18,0,16" />
                <TextBlock x:Name="ImageHeader" FontSize="14" FontWeight="SemiBold" />
                <TextBlock x:Name="NoiseLabel" Margin="0,10,0,5" Foreground="{DynamicResource MutedTextBrush}" FontSize="11" />
                <ComboBox x:Name="NoiseCombo" />

                <Separator Margin="0,18,0,16" />
                <TextBlock x:Name="OutputHeader" FontSize="14" FontWeight="SemiBold" />
                <TextBlock x:Name="OutputHintText" Margin="0,9,0,0" Foreground="{DynamicResource MutedTextBrush}" FontSize="11" TextWrapping="Wrap" />
                <TextBlock x:Name="ErrorText" Margin="0,12,0,0" Foreground="{DynamicResource AccentBrush}" TextWrapping="Wrap" />
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="CancelButton" Margin="0,0,8,0" Click="CancelButton_Click" AutomationProperties.Name="Cancel" />
            <Button x:Name="SaveButton" Style="{StaticResource PrimaryButtonStyle}" Click="SaveButton_Click" AutomationProperties.Name="Save settings" />
        </StackPanel>
    </Grid>
</Window>
