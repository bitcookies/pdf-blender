<Page x:Class="PDFBlender.App.Pages.HomePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:local="clr-namespace:PDFBlender.App"
      UseLayoutRounding="True"
      SnapsToDevicePixels="True">
    <Page.Resources>
        <LinearGradientBrush x:Key="HomeGradientBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="{DynamicResource AccentButtonStartColor}" Offset="0" />
            <GradientStop Color="{DynamicResource AccentButtonEndColor}" Offset="1" />
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="HomeGradientHoverBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="{DynamicResource AccentButtonHoverStartColor}" Offset="0" />
            <GradientStop Color="{DynamicResource AccentButtonHoverEndColor}" Offset="1" />
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="HomeGradientDisabledBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="{DynamicResource AccentButtonDisabledStartColor}" Offset="0" />
            <GradientStop Color="{DynamicResource AccentButtonDisabledEndColor}" Offset="1" />
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="CancelGradientBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="{DynamicResource CancelButtonStartColor}" Offset="0" />
            <GradientStop Color="{DynamicResource CancelButtonEndColor}" Offset="1" />
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="CancelGradientHoverBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="{DynamicResource CancelButtonHoverStartColor}" Offset="0" />
            <GradientStop Color="{DynamicResource CancelButtonHoverEndColor}" Offset="1" />
        </LinearGradientBrush>
        <SolidColorBrush x:Key="CancelGradientPressedBrush" Color="{DynamicResource CancelButtonPressedColor}" />
        <Style x:Key="HomeGradientSurfaceStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource HomeGradientBrush}" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource HomeGradientHoverBrush}" />
                </Trigger>

                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="{StaticResource HomeGradientDisabledBrush}" />
                </Trigger>
                <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="False">
                    <Setter Property="Background" Value="{StaticResource HomeGradientDisabledBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="BlendGradientSurfaceStyle" TargetType="Border" BasedOn="{StaticResource HomeGradientSurfaceStyle}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="ProcessingPressed">
                    <Setter Property="Background" Value="{StaticResource CancelGradientPressedBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="Processing">
                    <Setter Property="Background" Value="{StaticResource CancelGradientBrush}" />
                </DataTrigger>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="Processing" />
                        <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True" />
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Background" Value="{StaticResource CancelGradientHoverBrush}" />
                </MultiDataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="HomeGradientButtonStyle" TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ui:Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ContentPresenter Content="{TemplateBinding Content}"
                                              ContentTemplate="{TemplateBinding ContentTemplate}"
                                              ContentStringFormat="{TemplateBinding ContentStringFormat}"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              Margin="{TemplateBinding Padding}" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="Appearance" Value="Transparent" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="VerticalAlignment" Value="Stretch" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="Transparent" /><Setter Property="Foreground" Value="White" /></Trigger>
                <Trigger Property="IsPressed" Value="True"><Setter Property="Background" Value="Transparent" /><Setter Property="Foreground" Value="White" /></Trigger>
                <Trigger Property="IsEnabled" Value="False"><Setter Property="Background" Value="Transparent" /><Setter Property="Foreground" Value="White" /><Setter Property="Opacity" Value="1" /></Trigger>
            </Style.Triggers>
        </Style>
    </Page.Resources>
    <Grid Margin="20,12,20,14" UseLayoutRounding="True">
        <Grid.RowDefinitions>
            <RowDefinition Height="104" />
            <RowDefinition Height="10" />
            <RowDefinition Height="188" />
            <RowDefinition Height="8" />
            <RowDefinition Height="124" />
            <RowDefinition Height="36" />
            <RowDefinition Height="56" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Grid.RowSpan="3" Margin="0,0,-20,0" Panel.ZIndex="2" IsHitTestVisible="False" ClipToBounds="False">
            <Image Source="/PDFBlender.App;component/Assets/banner.png"
                   Stretch="Uniform"
                   Opacity="1"
                   HorizontalAlignment="Right"
                   VerticalAlignment="Top"
                   Width="580"
                   Height="157"
                   Margin="0,8,0,0" />
        </Grid>
        <Grid Grid.Row="0" Panel.ZIndex="3" Background="Transparent">
            <Grid VerticalAlignment="Center">
                <Grid.ColumnDefinitions><ColumnDefinition Width="70" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <Grid.RowDefinitions><RowDefinition Height="36" /><RowDefinition Height="26" /></Grid.RowDefinitions>
                <Image Grid.RowSpan="2" Width="66" Height="66" Source="pack://application:,,,/PDFBlender.App;component/Assets/logo.png" Stretch="Uniform" VerticalAlignment="Center" />
                <TextBlock x:Name="PageTitle" Grid.Column="1" Grid.Row="0" Margin="14,0,0,0" FontSize="29" FontWeight="Bold" Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center" />
                <TextBlock x:Name="PageSlogan" Grid.Column="1" Grid.Row="1" Margin="15,0,0,0" FontSize="12.5" Foreground="{DynamicResource MutedTextBrush}" VerticalAlignment="Center" />
            </Grid>
        </Grid>

        <ui:Card x:Name="DropCard" Grid.Row="2" Height="188" MinHeight="188" MaxHeight="188" Panel.ZIndex="4" Padding="10" AllowDrop="True" DragEnter="DropCard_DragEnter" DragOver="DropTarget_DragOver" DragLeave="DropCard_DragLeave" Drop="DropTarget_Drop" Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" AutomationProperties.Name="PDF drop area">
            <Grid Height="166">
                <Rectangle x:Name="DropDash" Margin="1" RadiusX="10" RadiusY="10" Stroke="{DynamicResource BorderBrush}" StrokeThickness="1.5" StrokeDashArray="5,4" IsHitTestVisible="False" />
                <Grid x:Name="EmptyDropContent" Margin="18,10">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Image Source="/PDFBlender.App;component/Assets/pdf-icon.png" Width="46" Height="46" Stretch="Uniform" HorizontalAlignment="Center" />
                        <TextBlock x:Name="DropTitleText" Style="{StaticResource CardTitleTextStyle}" FontSize="16" HorizontalAlignment="Center" Margin="0,6,0,0" />
                        <TextBlock x:Name="DropHintText" Style="{StaticResource CardDescriptionTextStyle}" HorizontalAlignment="Center" Margin="0,3,0,0" />
                        <Border Width="160" Height="40" Margin="0,9,0,0" CornerRadius="8" Style="{StaticResource HomeGradientSurfaceStyle}" Tag="{Binding IsEnabled, ElementName=BrowseButton}">
                            <ui:Button x:Name="BrowseButton" Style="{StaticResource HomeGradientButtonStyle}" Width="160" Height="40" Click="BrowseButton_Click" AutomationProperties.Name="Browse PDF">
                                <StackPanel Orientation="Horizontal"><ui:SymbolIcon Symbol="Document24" Margin="0,0,7,0" Foreground="White" /><TextBlock x:Name="BrowseButtonText" Foreground="White" /></StackPanel>
                            </ui:Button>
                        </Border>
                    </StackPanel>
                </Grid>

                <Grid x:Name="SelectedDropContent" Visibility="Collapsed" Margin="18,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="220" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="150" />
                    </Grid.ColumnDefinitions>
                    <Grid Grid.Column="0" Width="220" HorizontalAlignment="Left">
                        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" CanContentScroll="True">
                            <StackPanel x:Name="PreviewStrip" Orientation="Horizontal" VerticalAlignment="Center" />
                        </ScrollViewer>
                    </Grid>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="16,0,12,0">
                        <TextBlock x:Name="SelectedFileLabel" Style="{StaticResource CardTitleTextStyle}" FontSize="16" />
                        <TextBlock x:Name="FileNameText" FontSize="13" Foreground="{DynamicResource TextBrush}" TextTrimming="CharacterEllipsis" Margin="0,6,0,0" />
                        <TextBlock x:Name="SelectedCountText" FontSize="12" Foreground="{DynamicResource MutedTextBrush}" Margin="0,5,0,0" />
                        <TextBlock x:Name="PreviewErrorText" FontSize="11" Foreground="{DynamicResource MutedTextBrush}" TextWrapping="Wrap" Visibility="Collapsed" Margin="0,5,0,0" />
                    </StackPanel>
                    <TextBlock x:Name="AdditionalFilesHint" Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Center" TextAlignment="Center" FontSize="12" Foreground="{DynamicResource MutedTextBrush}" TextWrapping="Wrap" />
                </Grid>
            </Grid>
        </ui:Card>

        <Grid Grid.Row="4" Height="124" VerticalAlignment="Top" ClipToBounds="False">
            <local:BlendLevelRail x:Name="BlendLevelRailControl"
                                  Height="116"
                                  MinHeight="116"
                                  MaxHeight="116"
                                  VerticalAlignment="Top"
                                  SelectionChanged="BlendLevelRailControl_SelectionChanged"
                                  EditRequested="BlendLevelRailControl_EditRequested" />
        </Grid>

        <Grid Grid.Row="6">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0">
                <ui:Card Padding="12,8" MinHeight="42" Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource NotificationBorderBrush}" BorderThickness="1" AutomationProperties.Name="Status">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse x:Name="StatusDot" Width="7" Height="7" Fill="{DynamicResource AccentBrush}" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <TextBlock x:Name="StatusText" Foreground="{DynamicResource PillTextBrush}" FontSize="11.5" VerticalAlignment="Center" />
                    </StackPanel>
                </ui:Card>
                <ProgressBar x:Name="ProcessingProgress" Width="120" Height="5" Margin="10,0,8,0" Visibility="Collapsed" />
            </StackPanel>
            <Border Grid.Column="1" Width="250" Height="52" CornerRadius="8" HorizontalAlignment="Right" x:Name="BlendButtonSurface" Style="{StaticResource BlendGradientSurfaceStyle}" Tag="Ready" IsEnabled="{Binding IsEnabled, ElementName=BlendButton}">
                <ui:Button x:Name="BlendButton" Style="{StaticResource HomeGradientButtonStyle}" Width="250" Height="52" Click="BlendButton_Click" PreviewMouseLeftButtonDown="BlendButton_PreviewMouseLeftButtonDown" PreviewMouseLeftButtonUp="BlendButton_PreviewMouseLeftButtonUp" MouseLeave="BlendButton_MouseLeave" AutomationProperties.Name="Blend PDF">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <ui:SymbolIcon x:Name="BlendButtonIcon" Symbol="TriangleRight20" Filled="True" FontSize="19" Margin="0,0,8,0" Foreground="White" />
                        <TextBlock x:Name="BlendButtonText" FontSize="14" Foreground="White" />
                    </StackPanel>
                </ui:Button>
            </Border>
        </Grid>
    </Grid>
</Page>
