<Page x:Class="PDFBlender.App.Pages.HomePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:local="clr-namespace:PDFBlender.App"
      UseLayoutRounding="True"
      SnapsToDevicePixels="True">
    <Page.Resources>
        <Style x:Key="HomeGradientButtonStyle" TargetType="ui:Button" BasedOn="{StaticResource PrimaryActionButtonStyle}">
            <Setter Property="Background">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#C9021E" Offset="0" />
                        <GradientStop Color="#F06A73" Offset="1" />
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
            <Setter Property="Foreground" Value="White" />
            <Setter Property="MinHeight" Value="52" />
            <Setter Property="Padding" Value="20,10" />
        </Style>
    </Page.Resources>
    <Grid Margin="20,12,20,14" UseLayoutRounding="True">
        <Grid.RowDefinitions>
            <RowDefinition Height="92" />
            <RowDefinition Height="10" />
            <RowDefinition Height="188" />
            <RowDefinition Height="8" />
            <RowDefinition Height="100" />
            <RowDefinition Height="8" />
            <RowDefinition Height="56" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" ClipToBounds="True">
            <Image Source="/PDFBlender.App;component/Assets/banner.png" Stretch="UniformToFill" Opacity="0.88" HorizontalAlignment="Right" Width="500" IsHitTestVisible="False" />
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Border Width="58" Height="58" CornerRadius="14" Background="{DynamicResource LogoTileBrush}" Padding="7">
                    <Image Source="/PDFBlender.App;component/Assets/logo.png" Stretch="Uniform" />
                </Border>
                <StackPanel Margin="16,0,0,0" VerticalAlignment="Center">
                    <TextBlock x:Name="PageTitle" FontSize="28" FontWeight="Bold" Foreground="{DynamicResource TextBrush}" />
                    <TextBlock x:Name="PageSlogan" FontSize="12.5" Foreground="{DynamicResource MutedTextBrush}" Margin="1,3,0,0" />
                </StackPanel>
            </StackPanel>
        </Grid>

        <ui:Card x:Name="DropCard" Grid.Row="2" Padding="10" AllowDrop="True" DragEnter="DropCard_DragEnter" DragOver="DropTarget_DragOver" DragLeave="DropCard_DragLeave" Drop="DropTarget_Drop" Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" AutomationProperties.Name="PDF drop area">
            <Grid>
                <Rectangle x:Name="DropDash" Margin="1" RadiusX="10" RadiusY="10" Stroke="{DynamicResource BorderBrush}" StrokeThickness="1.5" StrokeDashArray="5,4" IsHitTestVisible="False" />
                <Grid x:Name="EmptyDropContent" Margin="18,10">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Image Source="/PDFBlender.App;component/Assets/pdf-icon.png" Width="54" Height="54" Stretch="Uniform" HorizontalAlignment="Center" />
                        <TextBlock x:Name="DropTitleText" Style="{StaticResource CardTitleTextStyle}" FontSize="16" HorizontalAlignment="Center" Margin="0,6,0,0" />
                        <TextBlock x:Name="DropHintText" Style="{StaticResource CardDescriptionTextStyle}" HorizontalAlignment="Center" Margin="0,3,0,0" />
                        <ui:Button x:Name="BrowseButton" Style="{StaticResource HomeGradientButtonStyle}" Height="38" Margin="0,9,0,0" Click="BrowseButton_Click" AutomationProperties.Name="Browse PDF">
                            <StackPanel Orientation="Horizontal"><ui:SymbolIcon Symbol="FolderOpen24" Margin="0,0,7,0" /><TextBlock x:Name="BrowseButtonText" /></StackPanel>
                        </ui:Button>
                    </StackPanel>
                </Grid>

                <Grid x:Name="SelectedDropContent" Visibility="Collapsed" Margin="18,10">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="116" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <Border Width="92" Height="142" Background="{DynamicResource SurfaceRaisedBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" HorizontalAlignment="Left" Padding="6">
                        <Grid>
                            <Image x:Name="PreviewImage" Stretch="Uniform" />
                            <Image x:Name="PreviewFallbackImage" Source="/PDFBlender.App;component/Assets/pdf-icon.png" Width="54" Height="54" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" />
                            <Border x:Name="PreviewLoadingOverlay" Background="{DynamicResource SurfaceRaisedBrush}" Opacity="0.92" Visibility="Collapsed">
                                <StackPanel VerticalAlignment="Center"><ui:ProgressRing IsIndeterminate="True" Width="24" Height="24" HorizontalAlignment="Center" /><TextBlock x:Name="PreviewLoadingText" FontSize="10" Foreground="{DynamicResource MutedTextBrush}" HorizontalAlignment="Center" Margin="0,6,0,0" /></StackPanel>
                            </Border>
                            <ui:Button x:Name="RemovePdfButton" Width="26" Height="26" Padding="0" HorizontalAlignment="Right" VerticalAlignment="Top" Appearance="Transparent" Click="RemovePdfButton_Click" ToolTip="Remove PDF" AutomationProperties.Name="Remove PDF"><ui:SymbolIcon Symbol="DismissCircle16" FontSize="16" /></ui:Button>
                        </Grid>
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="16,0,12,0">
                        <TextBlock x:Name="SelectedFileLabel" Style="{StaticResource CardTitleTextStyle}" FontSize="16" />
                        <TextBlock x:Name="FileNameText" FontSize="13" Foreground="{DynamicResource TextBrush}" TextTrimming="CharacterEllipsis" Margin="0,6,0,0" />
                        <TextBlock x:Name="SelectedCountText" FontSize="12" Foreground="{DynamicResource MutedTextBrush}" Margin="0,5,0,0" />
                        <TextBlock x:Name="PreviewErrorText" FontSize="11" Foreground="{DynamicResource MutedTextBrush}" TextWrapping="Wrap" Visibility="Collapsed" Margin="0,5,0,0" />
                    </StackPanel>
                    <ui:Button x:Name="ReplacePdfButton" Grid.Column="2" Style="{StaticResource HomeGradientButtonStyle}" Height="38" VerticalAlignment="Center" Click="BrowseButton_Click" AutomationProperties.Name="Replace PDF"><StackPanel Orientation="Horizontal"><ui:SymbolIcon Symbol="ArrowSync24" Margin="0,0,7,0" /><TextBlock x:Name="ReplacePdfButtonText" /></StackPanel></ui:Button>
                </Grid>
            </Grid>
        </ui:Card>

        <Grid Grid.Row="4"><local:BlendLevelRail x:Name="BlendLevelRailControl" SelectionChanged="BlendLevelRailControl_SelectionChanged" EditRequested="BlendLevelRailControl_EditRequested" /></Grid>

        <Grid Grid.Row="6">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Border Style="{StaticResource PillBorderStyle}" Padding="9,4"><StackPanel Orientation="Horizontal"><Ellipse Width="7" Height="7" Fill="{DynamicResource AccentBrush}" VerticalAlignment="Center" Margin="0,0,6,0" /><TextBlock x:Name="StatusText" Foreground="{DynamicResource PillTextBrush}" FontSize="11.5" VerticalAlignment="Center" /></StackPanel></Border>
                <ProgressBar x:Name="ProcessingProgress" Width="120" Height="5" Margin="10,0,8,0" Visibility="Collapsed" />
                <ui:Button x:Name="CancelButton" Style="{StaticResource SecondaryActionButtonStyle}" Padding="10,5" Visibility="Collapsed" Click="CancelButton_Click"><StackPanel Orientation="Horizontal"><ui:SymbolIcon Symbol="Dismiss24" Margin="0,0,6,0" /><TextBlock x:Name="CancelButtonText" /></StackPanel></ui:Button>
            </StackPanel>
            <ui:Button x:Name="BlendButton" Grid.Column="1" Style="{StaticResource HomeGradientButtonStyle}" Width="166" Click="BlendButton_Click" AutomationProperties.Name="Blend PDF"><StackPanel Orientation="Horizontal" HorizontalAlignment="Center"><ui:SymbolIcon Symbol="Play24" FontSize="19" Margin="0,0,8,0" /><TextBlock x:Name="BlendButtonText" FontSize="14" /></StackPanel></ui:Button>
        </Grid>
    </Grid>
</Page>
