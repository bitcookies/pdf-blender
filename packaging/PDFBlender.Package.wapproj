<Project ToolsVersion="15.0" DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup Label="Globals">
    <ProjectGuid>{7F70C0F0-1D8A-4B0C-9C19-3D7C0A5D6F10}</ProjectGuid>
    <RootNamespace>PDFBlender.Package</RootNamespace>
    <MinimumVisualStudioVersion>17.0</MinimumVisualStudioVersion>
    <TargetPlatformVersion>10.0.22621.0</TargetPlatformVersion>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <TargetFrameworkVersion>v4.7.2</TargetFrameworkVersion>
    <DefaultLanguage>en-US</DefaultLanguage>
    <!-- Declare the supported packaging platforms explicitly. -->
    <Platforms>x86;x64;ARM64</Platforms>
    <Platform Condition="'$(Platform)' == ''">x86</Platform>
  </PropertyGroup>
  <Import Project="$(VSToolsPath)\DotNet\Microsoft.DotNet.Props" Condition="'$(VSToolsPath)' != '' And Exists('$(VSToolsPath)\DotNet\Microsoft.DotNet.Props')" />
  <Import Project="$(MSBuildExtensionsPath)\Microsoft\DesktopBridge\Microsoft.DesktopBridge.props" Condition="Exists('$(MSBuildExtensionsPath)\Microsoft\DesktopBridge\Microsoft.DesktopBridge.props')" />
  <PropertyGroup>
    <EntryPointProjectUniqueName>..\src\PDFBlender.App\PDFBlender.App.csproj</EntryPointProjectUniqueName>
    <AppxPackageSigningEnabled>false</AppxPackageSigningEnabled>
    <AppxBundle>Always</AppxBundle>
    <AppxBundlePlatforms>x86|x64|ARM64</AppxBundlePlatforms>
    <AppxPackageDir>$(MSBuildThisFileDirectory)..\publish\installer\</AppxPackageDir>
    <GenerateAppInstallerFile>false</GenerateAppInstallerFile>
    <AppxSymbolPackageEnabled>true</AppxSymbolPackageEnabled>
    <AppxPackageIncludePrivateSymbols>false</AppxPackageIncludePrivateSymbols>
    <!-- VS 2026 no longer strips private symbols; standard PDBs go only to the Store symbol archive. -->
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\src\PDFBlender.App\PDFBlender.App.csproj">
      <ReferenceOutputAssembly>false</ReferenceOutputAssembly>
      <SkipGetTargetFrameworkProperties>true</SkipGetTargetFrameworkProperties>
    </ProjectReference>
  </ItemGroup>
  <ItemGroup>
    <AppxManifest Include="Package.appxmanifest" />
    <Content Include="Assets\*.png" />
    <PRIResource Include="Strings\en-US\Resources.resw" />
    <PRIResource Include="Strings\zh-CN\Resources.resw" />
  </ItemGroup>
  <Import Project="$(MSBuildExtensionsPath)\Microsoft\DesktopBridge\Microsoft.DesktopBridge.targets" Condition="Exists('$(MSBuildExtensionsPath)\Microsoft\DesktopBridge\Microsoft.DesktopBridge.targets')" />
</Project>
