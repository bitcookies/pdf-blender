<Page x:Class="PDFBlender.App.Pages.SettingsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <Page.Resources>
        <Style x:Key="SettingsCardStyle" TargetType="Border">
            <Setter Property="Height" Value="84" />
            <Setter Property="Margin" Value="0,0,0,8" />
            <Setter Property="Padding" Value="14,12" />
            <Setter Property="Background" Value="{DynamicResource CardBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="VerticalAlignment" Value="Top" />
        </Style>
        <Style x:Key="AboutRowLabelStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{DynamicResource AppFontFamily}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="Normal" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="AboutRowValueStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{DynamicResource AppFontFamily}" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="FontWeight" Value="Normal" />
            <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="AboutSummaryButtonStyle" TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
            <Setter Property="Appearance" Value="Transparent" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ui:Button">
                        <Border x:Name="SummarySurface"
                                Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}"
                                CornerRadius="{TemplateBinding CornerRadius}"
                                ClipToBounds="True">
                            <ContentPresenter Content="{TemplateBinding Content}"
                                              ContentTemplate="{TemplateBinding ContentTemplate}"
                                              ContentStringFormat="{TemplateBinding ContentStringFormat}"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="SummarySurface" Property="Background" Value="{DynamicResource SurfaceMutedBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="SummarySurface" Property="Background" Value="{DynamicResource SurfaceRaisedBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="NotificationSoundComboBoxItemStyle" TargetType="ComboBoxItem" BasedOn="{StaticResource {x:Type ComboBoxItem}}">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}" />
                    <Setter Property="Opacity" Value="0.62" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="NotificationSoundComboBoxStyle" TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="ItemContainerStyle" Value="{StaticResource NotificationSoundComboBoxItemStyle}" />
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}" />
                    <Setter Property="Opacity" Value="0.62" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </Page.Resources>
    <ScrollViewer x:Name="SettingsScrollViewer"
                  VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  Loaded="SettingsScrollViewer_Loaded"
                  ScrollChanged="SettingsScrollViewer_ScrollChanged"
                  PreviewMouseWheel="SettingsScrollViewer_PreviewMouseWheel">
        <StackPanel Margin="24,20,24,24" MaxWidth="760">
            <TextBlock x:Name="TitleText" Style="{StaticResource PageTitleTextStyle}" />
            <TextBlock x:Name="SubtitleText" Style="{StaticResource PageDescriptionTextStyle}" />
            <TextBlock x:Name="AppearanceHeader" Style="{StaticResource SectionTitleTextStyle}" />
            <StackPanel Margin="0,0,0,16">
            <Border Style="{StaticResource SettingsCardStyle}">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="48" /><ColumnDefinition Width="*" /><ColumnDefinition Width="220" /></Grid.ColumnDefinitions>
                    <ui:SymbolIcon Symbol="Color24" FontSize="22" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock x:Name="ThemeLabel" Style="{StaticResource CardTitleTextStyle}" /><TextBlock x:Name="ThemeHint" Style="{StaticResource SmallMutedTextStyle}" /></StackPanel>
                    <ComboBox x:Name="ThemeOptions" Grid.Column="2" VerticalAlignment="Center" SelectionChanged="ThemeOptions_SelectionChanged" />
                </Grid>
            </Border>
            <Border Style="{StaticResource SettingsCardStyle}">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="48" /><ColumnDefinition Width="*" /><ColumnDefinition Width="220" /></Grid.ColumnDefinitions>
                    <ui:SymbolIcon Symbol="LocalLanguage24" FontSize="22" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock x:Name="LanguageLabel" Style="{StaticResource CardTitleTextStyle}" /><TextBlock x:Name="LanguageHint" Style="{StaticResource SmallMutedTextStyle}" /></StackPanel>
                    <ComboBox x:Name="LanguageOptions" Grid.Column="2" VerticalAlignment="Center" SelectionChanged="LanguageOptions_SelectionChanged" />
                </Grid>
            </Border>
            </StackPanel>
            <TextBlock x:Name="StorageHeader" Style="{StaticResource SectionTitleTextStyle}" />
            <StackPanel Margin="0,0,0,16">
            <Border Style="{StaticResource SettingsCardStyle}">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="48" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <ui:SymbolIcon Symbol="Settings24" FontSize="22" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,14,0"><TextBlock x:Name="SettingsFileLabel" Style="{StaticResource CardTitleTextStyle}" /><TextBlock x:Name="SettingsFilePath" Style="{StaticResource SmallMutedTextStyle}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" /></StackPanel>
                    <ui:Button x:Name="OpenFolderButton" Grid.Column="2" VerticalAlignment="Center" Click="OpenFolderButton_Click" Appearance="Secondary">
                        <StackPanel Orientation="Horizontal"><ui:SymbolIcon Symbol="FolderOpen24" Margin="0,0,7,0" /><TextBlock x:Name="OpenFolderButtonText" /></StackPanel>
                    </ui:Button>
                </Grid>
            </Border>
            <Border Style="{StaticResource SettingsCardStyle}">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="48" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <ui:SymbolIcon Symbol="WindowMultiple20" FontSize="22" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,14,0">
                        <TextBlock x:Name="AllowMultipleInstancesLabel" Style="{StaticResource CardTitleTextStyle}" />
                        <TextBlock x:Name="AllowMultipleInstancesHint" Style="{StaticResource SmallMutedTextStyle}" TextWrapping="Wrap" />
                    </StackPanel>
                    <ui:ToggleSwitch x:Name="AllowMultipleInstancesToggle" Grid.Column="2" VerticalAlignment="Center" Click="AllowMultipleInstancesToggle_Click" />
                </Grid>
            </Border>

            </StackPanel>
            <TextBlock x:Name="SoundHeader" Style="{StaticResource SectionTitleTextStyle}" />
            <StackPanel Margin="0,0,0,16">
                <Border Style="{StaticResource SettingsCardStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="48" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <ui:SymbolIcon Symbol="Alert24" FontSize="22" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,14,0">
                            <TextBlock x:Name="BannerNotificationsLabel" Style="{StaticResource CardTitleTextStyle}" />
                            <TextBlock x:Name="BannerNotificationsHint" Style="{StaticResource SmallMutedTextStyle}" TextWrapping="Wrap" />
                        </StackPanel>
                        <ui:ToggleSwitch x:Name="BannerNotificationsToggle" Grid.Column="2" VerticalAlignment="Center" Click="BannerNotificationsToggle_Click" />
                    </Grid>
                </Border>
                <Border Style="{StaticResource SettingsCardStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="48" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <ui:SymbolIcon Symbol="Speaker224" FontSize="22" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,14,0">
                            <TextBlock x:Name="BannerNotificationSoundLabel" Style="{StaticResource CardTitleTextStyle}" />
                            <TextBlock x:Name="BannerNotificationSoundHint" Style="{StaticResource SmallMutedTextStyle}" TextWrapping="Wrap" />
                        </StackPanel>
                        <ui:ToggleSwitch x:Name="ToastSoundToggle" Grid.Column="2" VerticalAlignment="Center" Click="ToastSoundToggle_Click" />
                    </Grid>
                </Border>
                <Border Style="{StaticResource SettingsCardStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="48" /><ColumnDefinition Width="*" /><ColumnDefinition Width="220" /></Grid.ColumnDefinitions>
                        <ui:SymbolIcon Symbol="MusicNote224" FontSize="22" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" x:Name="NotificationSoundLabel" Style="{StaticResource CardTitleTextStyle}" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <ComboBox x:Name="ToastSoundOptions" Width="168" VerticalAlignment="Center" Style="{StaticResource NotificationSoundComboBoxStyle}" SelectionChanged="ToastSoundOptions_SelectionChanged" />
                            <ui:Button x:Name="TestToastSoundButton" Width="36" Height="36" Margin="6,0,0,0" Padding="0" Appearance="Secondary" Click="TestToastSoundButton_Click" ToolTip="Test sound" AutomationProperties.Name="Test notification sound">
                                <ui:SymbolIcon Symbol="Play24" FontSize="17" />
                            </ui:Button>
                        </StackPanel>
                    </Grid>
                </Border>
                <Border Style="{StaticResource SettingsCardStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="48" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <ui:SymbolIcon Symbol="WindowApps24" FontSize="22" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,14,0">
                            <TextBlock x:Name="WindowsNotificationsLabel" Style="{StaticResource CardTitleTextStyle}" />
                            <TextBlock x:Name="WindowsNotificationsHint" Style="{StaticResource SmallMutedTextStyle}" TextWrapping="Wrap" />
                        </StackPanel>
                        <ui:ToggleSwitch x:Name="WindowsNotificationsToggle" Grid.Column="2" VerticalAlignment="Center" Click="WindowsNotificationsToggle_Click" />
                    </Grid>
                </Border>
            </StackPanel>
            <TextBlock x:Name="AboutHeader" Style="{StaticResource SectionTitleTextStyle}" Margin="0,20,0,8" />
            <Border Padding="0" Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="14" ClipToBounds="True">
                <StackPanel>
                    <ui:Button x:Name="AboutSummaryButton" Style="{StaticResource AboutSummaryButtonStyle}" Padding="12,8" MinHeight="76"
                               Margin="1,1,1,0"
                               HorizontalContentAlignment="Stretch" HorizontalAlignment="Stretch"
                               CornerRadius="13" Cursor="Hand" Click="AboutSummaryButton_Click"
                               AutomationProperties.Name="About">
                        <Grid Margin="0,0,20,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="56" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="40" />
                            </Grid.ColumnDefinitions>
                            <Image Grid.Column="0" Width="48" Height="48" Source="/PDFBlender.App;component/Assets/logo.png" Stretch="Uniform" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="12,0,12,0">
                                <TextBlock x:Name="AboutProductName" Style="{StaticResource CardTitleTextStyle}" />
                                <TextBlock x:Name="AboutCopyrightText" Style="{StaticResource SmallMutedTextStyle}" Margin="0,3,0,0" />
                            </StackPanel>
                            <TextBlock x:Name="AboutVersionText" Grid.Column="2" VerticalAlignment="Center" Foreground="{DynamicResource MutedTextBrush}" FontSize="13" Margin="0,0,8,0" />
                            <ui:SymbolIcon x:Name="AboutExpandIcon" Grid.Column="3" Symbol="ChevronDown24" FontSize="18" Foreground="{DynamicResource MutedTextBrush}" VerticalAlignment="Center" HorizontalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                                <ui:SymbolIcon.RenderTransform>
                                    <RotateTransform Angle="0" />
                                </ui:SymbolIcon.RenderTransform>
                            </ui:SymbolIcon>
                        </Grid>
                    </ui:Button>
                    <Border x:Name="AboutDetails" Margin="1,0,1,1" Visibility="Collapsed">
                        <StackPanel>
                            <Grid MinHeight="46" Margin="16,0">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <TextBlock x:Name="AboutGithubLabel" Style="{StaticResource AboutRowLabelStyle}" />
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="github.com/bitcookies/pdf-blender" Style="{StaticResource AboutRowValueStyle}" />
                                    <ui:Button Tag="https://github.com/bitcookies/pdf-blender" Appearance="Transparent" Background="{DynamicResource SurfaceMutedBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Cursor="Hand" Click="AboutLinkButton_Click" Width="32" Height="32" Padding="4" Margin="8,0,0,0" CornerRadius="8" ToolTip="Open link" AutomationProperties.Name="Open GitHub project">
                                        <ui:SymbolIcon Symbol="Open24" FontSize="15" />
                                    </ui:Button>
                                </StackPanel>
                            </Grid>
                            <Border Height="1" Background="{DynamicResource BorderBrush}" />
                            <Grid MinHeight="46" Margin="16,0">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <TextBlock x:Name="AboutLicenseLabel" Style="{StaticResource AboutRowLabelStyle}" />
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="GNU General Public License v3.0" Style="{StaticResource AboutRowValueStyle}" />
                                    <ui:Button Tag="https://github.com/bitcookies/pdf-blender/blob/main/LICENSE" Appearance="Transparent" Background="{DynamicResource SurfaceMutedBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Cursor="Hand" Click="AboutLinkButton_Click" Width="32" Height="32" Padding="4" Margin="8,0,0,0" CornerRadius="8" ToolTip="Open license" AutomationProperties.Name="Open license">
                                        <ui:SymbolIcon Symbol="Open24" FontSize="15" />
                                    </ui:Button>
                                </StackPanel>
                            </Grid>
                            <Border Height="1" Background="{DynamicResource BorderBrush}" />
                            <Grid MinHeight="46" Margin="16,0">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <TextBlock x:Name="AboutFeedbackLabel" Style="{StaticResource AboutRowLabelStyle}" />
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="GitHub Issues" Style="{StaticResource AboutRowValueStyle}" />
                                    <ui:Button Tag="https://github.com/bitcookies/pdf-blender/issues" Appearance="Transparent" Background="{DynamicResource SurfaceMutedBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Cursor="Hand" Click="AboutLinkButton_Click" Width="32" Height="32" Padding="4" Margin="8,0,0,0" CornerRadius="8" ToolTip="Open issues" AutomationProperties.Name="Open GitHub issues">
                                        <ui:SymbolIcon Symbol="Open24" FontSize="15" />
                                    </ui:Button>
                                </StackPanel>
                            </Grid>
                            <Border Height="1" Background="{DynamicResource BorderBrush}" />
                            <Grid MinHeight="50" Margin="16,0">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <TextBlock x:Name="AboutDeveloperLabel" Style="{StaticResource AboutRowLabelStyle}" />
                                <Image Grid.Column="1" Source="/PDFBlender.App;component/Assets/bitcookies-words.png" Width="100" Height="28" Stretch="Uniform" Opacity="0.88" />
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
