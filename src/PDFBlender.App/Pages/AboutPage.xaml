<Page x:Class="PDFBlender.App.Pages.AboutPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="24,20,24,24" MaxWidth="760">
            <ui:Card Padding="20">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="64" Height="64" CornerRadius="16" Background="{DynamicResource LogoTileBrush}" Padding="7">
                            <Image Source="/PDFBlender.App;component/Assets/logo.png" Stretch="Uniform" />
                        </Border>
                        <StackPanel Margin="16,0,0,0" VerticalAlignment="Center">
                            <TextBlock x:Name="ProductName" FontSize="24" FontWeight="SemiBold" />
                            <TextBlock x:Name="VersionText" Margin="0,4,0,0" Foreground="{DynamicResource MutedTextBrush}" />
                            <TextBlock x:Name="TechnologyText" Margin="0,8,0,0" Foreground="{DynamicResource MutedTextBrush}" />
                        </StackPanel>
                    </StackPanel>
                    <Image Grid.Column="1" Source="/PDFBlender.App;component/Assets/bitcookies-words.png"
                           Width="150" Height="43" Stretch="Uniform" Opacity="0.88" VerticalAlignment="Center" />
                </Grid>
            </ui:Card>

            <TextBlock x:Name="ProjectHeader" Style="{StaticResource SectionTitleTextStyle}" Margin="0,24,0,8" />
            <ui:Card Padding="16">
                <StackPanel>
                    <TextBlock x:Name="ProjectDescriptionText" TextWrapping="Wrap" />
                    <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                        <ui:Button x:Name="GithubButton" Appearance="Secondary" Click="GithubButton_Click"
                                   AutomationProperties.Name="GitHub project">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Globe24" Margin="0,0,7,0" />
                                <TextBlock x:Name="GithubButtonText" />
                            </StackPanel>
                        </ui:Button>
                        <ui:Button x:Name="FeedbackButton" Appearance="Transparent" Click="FeedbackButton_Click"
                                   Margin="8,0,0,0" AutomationProperties.Name="Feedback">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Chat24" Margin="0,0,7,0" />
                                <TextBlock x:Name="FeedbackButtonText" />
                            </StackPanel>
                        </ui:Button>
                    </StackPanel>
                    <TextBlock x:Name="FeedbackHintText" Margin="0,10,0,0" Style="{StaticResource SmallMutedTextStyle}" />
                </StackPanel>
            </ui:Card>

            <TextBlock x:Name="PrivacyHeader" Style="{StaticResource SectionTitleTextStyle}" Margin="0,20,0,8" />
            <ui:Card Padding="16">
                <StackPanel>
                    <TextBlock x:Name="LocalProcessingText" TextWrapping="Wrap" />
                    <TextBlock x:Name="StoreText" Margin="0,10,0,0" Foreground="{DynamicResource MutedTextBrush}" TextWrapping="Wrap" />
                </StackPanel>
            </ui:Card>

            <TextBlock x:Name="LegalHeader" Style="{StaticResource SectionTitleTextStyle}" Margin="0,20,0,8" />
            <ui:Card Padding="16">
                <StackPanel>
                    <TextBlock x:Name="CopyrightText" TextWrapping="Wrap" />
                    <TextBlock x:Name="LicenseText" Margin="0,10,0,0" Foreground="{DynamicResource MutedTextBrush}" TextWrapping="Wrap" />
                </StackPanel>
            </ui:Card>

            <TextBlock x:Name="ThirdPartyHeader" Style="{StaticResource SectionTitleTextStyle}" Margin="0,20,0,8" />
            <ui:Card Padding="16">
                <TextBlock x:Name="ThirdPartyText" TextWrapping="Wrap" FontSize="12" />
            </ui:Card>
        </StackPanel>
    </ScrollViewer>
</Page>
