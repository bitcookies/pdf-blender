<Page x:Class="PDFBlender.App.Pages.ConfigurationPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <Grid>
        <ScrollViewer x:Name="ListScroller" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel x:Name="ListRoot" Margin="24,20,24,24" MaxWidth="760">
                <TextBlock x:Name="TitleText" Style="{StaticResource PageTitleTextStyle}" />
                <TextBlock x:Name="SubtitleText" Style="{StaticResource PageDescriptionTextStyle}" Margin="0,3,0,10" />
                <TextBlock x:Name="SlotsHeader" Style="{StaticResource SectionTitleTextStyle}" Margin="0" />
                <Grid x:Name="SlotsPanel" Margin="0,6,0,0" />
                <Separator Margin="0,10,0,10" />
                <Grid Margin="0,0,0,8">
                    <TextBlock x:Name="ConfigurationsHeader" Style="{StaticResource SectionTitleTextStyle}" Margin="0" VerticalAlignment="Bottom" />
                    <ui:Button x:Name="AddButton" HorizontalAlignment="Right" Padding="12,6" Click="AddButton_Click" Cursor="Hand">
                        <StackPanel Orientation="Horizontal"><ui:SymbolIcon Symbol="Add24" Margin="0,0,6,0" /><TextBlock x:Name="AddButtonText" /></StackPanel>
                    </ui:Button>
                </Grid>
                <TextBlock x:Name="EmptyText" Style="{StaticResource SmallMutedTextStyle}" Margin="0,0,0,8" />
                <UniformGrid x:Name="ConfigurationCardsPanel" Columns="5" />
                <TextBlock x:Name="ErrorText" Foreground="{DynamicResource AccentBrush}" TextWrapping="Wrap" Margin="0,10,0,0" />
            </StackPanel>
        </ScrollViewer>
        <ContentControl x:Name="ChildContent" Visibility="Collapsed" />
    </Grid>
</Page>
