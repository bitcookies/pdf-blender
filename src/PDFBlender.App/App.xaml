<Application x:Class="PDFBlender.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ui:ThemesDictionary Theme="Light" />
                <ui:ControlsDictionary />
            </ResourceDictionary.MergedDictionaries>

            <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#F5F6F7" />
            <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="SurfaceRaisedBrush" Color="#F0F2F4" />
            <SolidColorBrush x:Key="SurfaceMutedBrush" Color="#F8F9FA" />
            <SolidColorBrush x:Key="BorderBrush" Color="#D9DDE3" />
            <SolidColorBrush x:Key="TextBrush" Color="#202124" />
            <SolidColorBrush x:Key="MutedTextBrush" Color="#6B7078" />
            <SolidColorBrush x:Key="AccentBrush" Color="#E45B59" />
            <SolidColorBrush x:Key="AccentDarkBrush" Color="#C8484D" />
            <SolidColorBrush x:Key="AccentTextBrush" Color="#FFFFFF" />

            <Style TargetType="TextBlock">
                <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                <Setter Property="FontFamily" Value="Segoe UI Variable, Segoe UI" />
            </Style>
            <Style TargetType="Page">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="FontFamily" Value="Segoe UI Variable, Segoe UI" />
            </Style>
            <Style TargetType="ComboBox">
                <Setter Property="MinHeight" Value="36" />
                <Setter Property="Padding" Value="10,6" />
                <Setter Property="FontSize" Value="13" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
