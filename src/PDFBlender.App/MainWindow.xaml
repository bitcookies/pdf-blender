<Window x:Class="PDFBlender.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:PDFBlender.App"
        Title="PDF Blender"
        Icon="/PDFBlender.App;component/Assets/logo.ico"
        Width="760"
        Height="560"
        MinWidth="680"
        MinHeight="500"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBackgroundBrush}">
    <Grid Margin="22,18,22,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="12" />
            <RowDefinition Height="*" />
            <RowDefinition Height="12" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="12" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="10" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal">
                <Border Width="36" Height="36" CornerRadius="10" Background="#FFF1F3" Padding="3">
                    <Image Source="/PDFBlender.App;component/Assets/logo.png" Stretch="Uniform" />
                </Border>
                <StackPanel Margin="11,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="PDF Blender" FontSize="19" FontWeight="SemiBold" />
                    <TextBlock x:Name="SubtitleText" Margin="0,2,0,0" Foreground="{DynamicResource MutedTextBrush}" FontSize="11" />
                </StackPanel>
            </StackPanel>
            <Button x:Name="SettingsButton"
                    Grid.Column="1"
                    Style="{StaticResource IconButtonStyle}"
                    Click="SettingsButton_Click"
                    ToolTip="Settings"
                    AutomationProperties.Name="Settings">
                <TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" />
            </Button>
        </Grid>

        <Border x:Name="DropTarget"
                Grid.Row="2"
                AllowDrop="True"
                DragOver="DropTarget_DragOver"
                Drop="DropTarget_Drop"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="14"
                Padding="20">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <StackPanel>
                    <TextBlock x:Name="DropTitleText" FontSize="18" FontWeight="SemiBold" />
                    <TextBlock x:Name="DropHintText" Margin="0,4,0,0" Foreground="{DynamicResource MutedTextBrush}" FontSize="12" />
                </StackPanel>

                <StackPanel Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Border Width="58" Height="58" CornerRadius="29" Background="#33FF756A" HorizontalAlignment="Center">
                        <TextBlock Text="&#xE8B7;"
                                   FontFamily="Segoe MDL2 Assets"
                                   FontSize="24"
                                   Foreground="{DynamicResource AccentBrush}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Border>
                    <TextBlock x:Name="ReadyText" Margin="0,12,0,0" FontSize="14" FontWeight="SemiBold" HorizontalAlignment="Center" />
                    <TextBlock x:Name="FileNameText"
                               Margin="0,5,0,0"
                               Foreground="{DynamicResource MutedTextBrush}"
                               FontSize="12"
                               HorizontalAlignment="Center"
                               TextTrimming="CharacterEllipsis"
                               MaxWidth="430" />
                    <Button x:Name="BrowseButton" Margin="0,14,0,0" Style="{StaticResource SecondaryButtonStyle}" Click="BrowseButton_Click" AutomationProperties.Name="Browse PDF">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE8B7;" FontFamily="Segoe MDL2 Assets" Margin="0,0,7,0" />
                            <TextBlock x:Name="BrowseButtonText" />
                        </StackPanel>
                    </Button>
                </StackPanel>

                <StackPanel Grid.Row="2" Orientation="Horizontal">
                    <TextBlock Text="PDF" Foreground="{DynamicResource AccentBrush}" FontWeight="SemiBold" FontSize="11" />
                    <TextBlock Text="  •  " Foreground="{DynamicResource MutedTextBrush}" FontSize="11" />
                    <TextBlock x:Name="LocalProcessingText" Foreground="{DynamicResource MutedTextBrush}" FontSize="11" />
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="4"
                Background="{DynamicResource SurfaceMutedBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="10"
                Padding="12,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.1*" />
                    <ColumnDefinition Width="20" />
                    <ColumnDefinition Width="1.7*" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock x:Name="ProfileLabel" Foreground="{DynamicResource MutedTextBrush}" FontSize="11" />
                    <ComboBox x:Name="ProfileCombo" Margin="0,4,0,0" SelectionChanged="ProfileCombo_SelectionChanged" />
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock x:Name="OutputLabel" Foreground="{DynamicResource MutedTextBrush}" FontSize="11" />
                    <TextBlock x:Name="OutputText" Margin="0,6,0,0" Text="—" TextTrimming="CharacterEllipsis" FontSize="12" />
                </StackPanel>
            </Grid>
        </Border>

        <local:BlendLevelRail x:Name="BlendLevelRailControl"
                              Grid.Row="6"
                              SelectionChanged="BlendLevelRailControl_SelectionChanged" />

        <Grid Grid.Row="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock x:Name="StatusText" Foreground="{DynamicResource MutedTextBrush}" FontSize="11" VerticalAlignment="Center" />
                <ProgressBar x:Name="ProcessingProgress" Width="110" Height="5" Margin="12,0,8,0" Visibility="Collapsed" />
                <Button x:Name="CancelButton" Padding="9,5" Visibility="Collapsed" Click="CancelButton_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE711;" FontFamily="Segoe MDL2 Assets" Margin="0,0,6,0" />
                        <TextBlock x:Name="CancelButtonText" />
                    </StackPanel>
                </Button>
            </StackPanel>
            <Button x:Name="BlendButton" Grid.Column="1" Style="{StaticResource PrimaryButtonStyle}" Click="BlendButton_Click" AutomationProperties.Name="Blend PDF">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE7C5;" FontFamily="Segoe MDL2 Assets" Margin="0,0,8,0" />
                    <TextBlock x:Name="BlendButtonText" />
                </StackPanel>
            </Button>
        </Grid>
    </Grid>
</Window>
