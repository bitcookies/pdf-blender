<Application x:Class="PDFBlender.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ui:ThemesDictionary Theme="Light" />
                <ui:ControlsDictionary />
                <ResourceDictionary Source="/PDFBlender.App;component/Resources/Colors.xaml" />
                <ResourceDictionary Source="/PDFBlender.App;component/Resources/Navigation.xaml" />
                <ResourceDictionary Source="/PDFBlender.App;component/Resources/Typography.xaml" />
                <ResourceDictionary Source="/PDFBlender.App;component/Resources/Buttons.xaml" />
                <ResourceDictionary Source="/PDFBlender.App;component/Resources/Inputs.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
