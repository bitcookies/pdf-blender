<Page x:Class="PDFBlender.App.Pages.ConfigurationPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="22,20,22,24" MaxWidth="760">
            <TextBlock x:Name="TitleText" Style="{StaticResource PageTitleTextStyle}" />
            <TextBlock x:Name="SubtitleText" Style="{StaticResource PageDescriptionTextStyle}" />

            <Border Background="{DynamicResource SettingItemBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="7" Padding="12" Margin="0,0,0,12">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="220" /></Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="ConfigurationNameLabel" FontSize="15" FontWeight="SemiBold" />
                        <TextBlock x:Name="ConfigurationNameHint" Style="{StaticResource SmallMutedTextStyle}" />
                    </StackPanel>
                    <ComboBox x:Name="ConfigurationCombo" Grid.Column="1" SelectionChanged="ConfigurationCombo_SelectionChanged" />
                </Grid>
            </Border>

            <Border Background="{DynamicResource SettingItemBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="7" Padding="12" Margin="0,0,0,18">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="220" /></Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="LevelLabel" FontSize="15" FontWeight="SemiBold" />
                        <TextBlock x:Name="LevelHint" Style="{StaticResource SmallMutedTextStyle}" />
                    </StackPanel>
                    <ComboBox x:Name="LevelCombo" Grid.Column="1" SelectionChanged="LevelCombo_SelectionChanged" />
                </Grid>
            </Border>

            <TextBlock x:Name="FormatHeader" Style="{StaticResource SectionTitleTextStyle}" />
            <Border Background="{DynamicResource SettingItemBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="7" Padding="12" Margin="0,0,0,12">
                <StackPanel>
                    <Grid MinHeight="64">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="120" /></Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center"><TextBlock x:Name="NormalizeLabel" FontSize="15" FontWeight="SemiBold" /><TextBlock x:Name="NormalizeHint" Style="{StaticResource SmallMutedTextStyle}" TextWrapping="Wrap" /></StackPanel>
                        <ui:ToggleSwitch x:Name="NormalizeWidthToggle" Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center" Checked="SettingsControl_Changed" Unchecked="SettingsControl_Changed" />
                    </Grid>
                    <Separator />
                    <Grid MinHeight="64">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="160" /></Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center"><TextBlock x:Name="TargetWidthLabel" FontSize="15" FontWeight="SemiBold" /><TextBlock x:Name="TargetWidthHint" Style="{StaticResource SmallMutedTextStyle}" TextWrapping="Wrap" /></StackPanel>
                        <ui:TextBox x:Name="TargetWidthText" Grid.Column="1" VerticalAlignment="Center" TextChanged="SettingsControl_Changed" />
                    </Grid>
                </StackPanel>
            </Border>

            <TextBlock x:Name="ProtectionHeader" Style="{StaticResource SectionTitleTextStyle}" />
            <Border Background="{DynamicResource SettingItemBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="7" Padding="12" Margin="0,0,0,12">
                <Grid MinHeight="64">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="220" /></Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center"><TextBlock x:Name="ProtectionLabel" FontSize="15" FontWeight="SemiBold" /><TextBlock x:Name="ProtectionHint" Style="{StaticResource SmallMutedTextStyle}" TextWrapping="Wrap" /></StackPanel>
                    <ComboBox x:Name="ProtectionCombo" Grid.Column="1" SelectionChanged="SettingsControl_Changed" />
                </Grid>
            </Border>

            <TextBlock x:Name="WatermarkHeader" Style="{StaticResource SectionTitleTextStyle}" />
            <Border Background="{DynamicResource SettingItemBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="7" Padding="12" Margin="0,0,0,12">
                <StackPanel>
                    <Grid MinHeight="64">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="220" /></Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center"><TextBlock x:Name="WatermarkTypeLabel" FontSize="15" FontWeight="SemiBold" /><TextBlock x:Name="WatermarkTypeHint" Style="{StaticResource SmallMutedTextStyle}" TextWrapping="Wrap" /></StackPanel>
                        <ComboBox x:Name="WatermarkCombo" Grid.Column="1" SelectionChanged="SettingsControl_Changed" />
                    </Grid>
                    <Separator />
                    <Grid MinHeight="64">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="280" /></Grid.ColumnDefinitions>
                        <TextBlock x:Name="WatermarkTextLabel" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <ui:TextBox x:Name="WatermarkTextBox" Grid.Column="1" VerticalAlignment="Center" TextChanged="SettingsControl_Changed" />
                    </Grid>
                </StackPanel>
            </Border>

            <TextBlock x:Name="ImageHeader" Style="{StaticResource SectionTitleTextStyle}" />
            <Border Background="{DynamicResource SettingItemBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="7" Padding="12">
                <Grid MinHeight="64">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="220" /></Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center"><TextBlock x:Name="NoiseLabel" FontSize="15" FontWeight="SemiBold" /><TextBlock x:Name="NoiseHint" Style="{StaticResource SmallMutedTextStyle}" TextWrapping="Wrap" /></StackPanel>
                    <ComboBox x:Name="NoiseCombo" Grid.Column="1" SelectionChanged="SettingsControl_Changed" />
                </Grid>
            </Border>
            <TextBlock x:Name="ErrorText" Foreground="{DynamicResource AccentBrush}" Margin="0,10,0,0" TextWrapping="Wrap" />
        </StackPanel>
    </ScrollViewer>
</Page>
