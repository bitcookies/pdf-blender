<Page x:Class="PDFBlender.App.Pages.ConfigurationPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:local="clr-namespace:PDFBlender.App"
>
    <Grid>
        <ScrollViewer x:Name="ListScroller" local:ScrollBarAutoHideBehavior.Enabled="True" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel x:Name="ListRoot" Margin="24,20,24,24" MaxWidth="760">
                <TextBlock x:Name="TitleText" Style="{StaticResource PageTitleTextStyle}" />
                <TextBlock x:Name="SubtitleText" Style="{StaticResource PageDescriptionTextStyle}" Margin="0,3,0,12" />
                <StackPanel>
                    <TextBlock x:Name="SlotsHeader" Style="{StaticResource SectionTitleTextStyle}" Margin="0" />
                    <TextBlock x:Name="SlotsHintText" Style="{StaticResource SmallMutedTextStyle}" Margin="0,3,0,0" />
                    <Grid x:Name="SlotsPanel" Margin="0,8,0,0" />
                </StackPanel>
                <Separator Margin="0,14,0,14" />
                <Grid Margin="0,0,0,10">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="ConfigurationsHeader" Style="{StaticResource SectionTitleTextStyle}" Margin="0" />
                        <TextBlock x:Name="ConfigurationsHintText" Style="{StaticResource SmallMutedTextStyle}" Margin="0,3,0,0" />
                    </StackPanel>
                    <ui:Button x:Name="AddButton" HorizontalAlignment="Right" VerticalAlignment="Center" Appearance="Secondary" Padding="12,6" Click="AddButton_Click" Cursor="Hand">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Add24" Margin="0,0,6,0" />
                            <TextBlock x:Name="AddButtonText" />
                        </StackPanel>
                    </ui:Button>
                </Grid>
                <TextBlock x:Name="EmptyText" Style="{StaticResource SmallMutedTextStyle}" Margin="0,0,0,8" />
                <UniformGrid x:Name="ConfigurationCardsPanel" Columns="5" />
                <TextBlock x:Name="ErrorText" Foreground="{DynamicResource AccentBrush}" TextWrapping="Wrap" Margin="0,10,0,0" />
            </StackPanel>
        </ScrollViewer>
        <Frame x:Name="ChildContent" NavigationUIVisibility="Hidden" Visibility="Collapsed" />
    </Grid>
</Page>
