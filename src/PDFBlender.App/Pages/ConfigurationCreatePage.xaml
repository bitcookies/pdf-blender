<Page x:Class="PDFBlender.App.Pages.ConfigurationCreatePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="24,20,24,24" MaxWidth="760">
            <ui:BreadcrumbBar x:Name="BreadcrumbBar" ItemClicked="BreadcrumbBar_ItemClicked" Margin="0,0,0,12" Cursor="Hand">
                <ui:BreadcrumbBar.Resources>
                    <SolidColorBrush x:Key="BreadcrumbBarHoverForegroundBrush" Color="#C9021E" />
                    <SolidColorBrush x:Key="BreadcrumbBarNormalForegroundBrush" Color="#868686" />
                </ui:BreadcrumbBar.Resources>
            </ui:BreadcrumbBar>
            <TextBlock x:Name="TitleText" Style="{StaticResource PageTitleTextStyle}" />
            <TextBlock x:Name="SubtitleText" Style="{StaticResource PageDescriptionTextStyle}" Margin="0,3,0,18" />
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <ui:Button x:Name="CustomButton" Grid.Column="0" Margin="0,0,6,0" Appearance="Secondary" Height="170" Click="CustomButton_Click" Cursor="Hand" />
                <ui:Button x:Name="PresetButton" Grid.Column="1" Margin="6,0,0,0" Appearance="Secondary" Height="170" Click="PresetButton_Click" Cursor="Hand" />
            </Grid>
        </StackPanel>
    </ScrollViewer>
</Page>
