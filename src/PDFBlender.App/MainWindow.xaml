<ui:FluentWindow x:Class="PDFBlender.App.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:local="clr-namespace:PDFBlender.App"
                 Title="PDF Blender"
                 Icon="/PDFBlender.App;component/Assets/logo.ico"
                 Width="820" Height="600" MinWidth="760" MinHeight="540"
                 WindowStartupLocation="CenterScreen"
                 WindowBackdropType="Mica"
                 WindowCornerPreference="Round"
                 ExtendsContentIntoTitleBar="True"
                 Background="{DynamicResource WindowBackgroundBrush}"
                 TextElement.FontFamily="{DynamicResource AppFontFamily}"
                 UseLayoutRounding="True"
                 SnapsToDevicePixels="True">
    <Grid Background="{DynamicResource WindowBackgroundBrush}"
          TextElement.FontFamily="{DynamicResource AppFontFamily}"
          TextElement.FontSize="13"
          UseLayoutRounding="True"
          SnapsToDevicePixels="True">
        <Grid.RowDefinitions>
            <RowDefinition Height="44" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <ui:TitleBar x:Name="ShellTitleBar" Grid.Row="0" Title="PDF Blender" Height="44" Padding="12,0" Background="{DynamicResource TitleBarBrush}" Foreground="{DynamicResource TitleTextBrush}" FontFamily="{DynamicResource AppFontFamily}">
            <ui:TitleBar.Icon>
                <ui:ImageIcon Source="/PDFBlender.App;component/Assets/logo.ico" Width="16" Height="16" />
            </ui:TitleBar.Icon>
        </ui:TitleBar>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions><ColumnDefinition Width="74" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <Border Grid.Column="0" Background="{DynamicResource SidebarBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0" Padding="8,8,8,12" TextElement.FontFamily="{DynamicResource AppFontFamily}">
                <Grid x:Name="RailRoot"
                      SizeChanged="RailRoot_SizeChanged">
                    <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <StackPanel Grid.Row="0">
                        <Button x:Name="HomeNavigationButton" Style="{StaticResource RailButtonStyle}" Click="HomeNavigationItem_Click" AutomationProperties.Name="Home">
                            <StackPanel><ui:SymbolIcon Symbol="Home24" FontSize="22" Foreground="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}" HorizontalAlignment="Center" /><TextBlock Text="Home" Style="{StaticResource RailLabelTextStyle}" /></StackPanel>
                        </Button>
                        <Button x:Name="ConfigurationNavigationButton" Style="{StaticResource RailButtonStyle}" Click="ConfigurationNavigationItem_Click" AutomationProperties.Name="Configuration">
                            <StackPanel><ui:SymbolIcon Symbol="Options24" FontSize="22" Foreground="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}" HorizontalAlignment="Center" /><TextBlock Text="Configuration" Style="{StaticResource RailLabelTextStyle}" /></StackPanel>
                        </Button>
                    </StackPanel>
                    <StackPanel Grid.Row="1">
                        <Button x:Name="SettingsNavigationButton" Style="{StaticResource RailButtonStyle}" Click="SettingsNavigationItem_Click" AutomationProperties.Name="Settings" Margin="0,1,0,12">
                            <StackPanel><ui:SymbolIcon Symbol="Settings24" FontSize="22" Foreground="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}" HorizontalAlignment="Center" /><TextBlock Text="Settings" Style="{StaticResource RailLabelTextStyle}" /></StackPanel>
                        </Button>
                        <Button x:Name="AboutNavigationButton" Style="{StaticResource RailButtonStyle}" Click="AboutNavigationItem_Click" AutomationProperties.Name="About">
                            <StackPanel><ui:SymbolIcon Symbol="Info24" FontSize="22" Foreground="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}" HorizontalAlignment="Center" /><TextBlock Text="About" Style="{StaticResource RailLabelTextStyle}" /></StackPanel>
                        </Button>
                    </StackPanel>
                    <Border x:Name="RailSelectionIndicator"
                            Width="4"
                            Height="24"
                            CornerRadius="2"
                            Background="{DynamicResource AccentBrush}"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Top"
                            IsHitTestVisible="False"
                            Panel.ZIndex="10">
                        <Border.RenderTransform>
                            <TranslateTransform Y="0" />
                        </Border.RenderTransform>
                    </Border>
                </Grid>
            </Border>
            <Grid Grid.Column="1">
                <Frame x:Name="ContentFrame" NavigationUIVisibility="Hidden" Margin="0" />
                <local:UiNotificationHost x:Name="AppNotificationHost" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,12,16,0" IsHitTestVisible="True" />
            </Grid>
        </Grid>
    </Grid>
</ui:FluentWindow>
