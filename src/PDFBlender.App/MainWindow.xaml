<Window x:Class="PDFBlender.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="PDF Blender"
        Width="1120"
        Height="720"
        MinWidth="900"
        MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBackgroundBrush}">
    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="24" />
            <RowDefinition Height="*" />
            <RowDefinition Height="20" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal">
                <Border Width="46" Height="46" CornerRadius="14" Background="#FFF1F3" Padding="4">
                    <Image Source="/PDFBlender.App;component/Assets/logo.png" Stretch="Uniform" />
                </Border>
                <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="PDF Blender" FontSize="24" FontWeight="SemiBold" />
                    <TextBlock x:Name="SubtitleText" Margin="0,3,0,0" Foreground="{DynamicResource MutedTextBrush}" FontSize="13" />
                </StackPanel>
            </StackPanel>
            <Button x:Name="ThemeButton" Grid.Column="1" Margin="0,0,10,0" Click="ThemeButton_Click" ToolTip="Toggle theme" />
            <Button x:Name="SettingsButton" Grid.Column="2" Click="SettingsButton_Click" />
        </Grid>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.45*" />
                <ColumnDefinition Width="24" />
                <ColumnDefinition Width="0.85*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="{DynamicResource SurfaceBrush}" CornerRadius="24" Padding="32">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <StackPanel>
                        <TextBlock x:Name="DropTitleText" FontSize="27" FontWeight="SemiBold" />
                        <TextBlock x:Name="DropHintText" Margin="0,8,0,0" Foreground="{DynamicResource MutedTextBrush}" FontSize="14" />
                    </StackPanel>

                    <Border x:Name="DropTarget"
                            Grid.Row="1"
                            Margin="0,28,0,28"
                            AllowDrop="True"
                            DragOver="DropTarget_DragOver"
                            Drop="DropTarget_Drop"
                            Background="{DynamicResource SurfaceMutedBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="18">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Border Width="74" Height="74" CornerRadius="37" Background="#33FF6C62" HorizontalAlignment="Center">
                                <TextBlock Text="＋" FontSize="42" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock x:Name="ReadyText" Margin="0,18,0,0" FontSize="17" FontWeight="SemiBold" HorizontalAlignment="Center" />
                            <TextBlock x:Name="FileNameText" Margin="0,8,0,0" Foreground="{DynamicResource MutedTextBrush}" FontSize="13" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="440" />
                            <Button x:Name="BrowseButton" Margin="0,24,0,0" Click="BrowseButton_Click" />
                        </StackPanel>
                    </Border>

                    <StackPanel Grid.Row="2" Orientation="Horizontal">
                        <TextBlock Text="PDF" Foreground="{DynamicResource AccentBrush}" FontWeight="SemiBold" />
                        <TextBlock Text="  •  " Foreground="{DynamicResource MutedTextBrush}" />
                        <TextBlock x:Name="LocalProcessingText" Foreground="{DynamicResource MutedTextBrush}" />
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Column="2" Background="{DynamicResource SurfaceBrush}" CornerRadius="24" Padding="26">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock x:Name="SetupTitleText" FontSize="21" FontWeight="SemiBold" />

                    <StackPanel Grid.Row="1" Margin="0,28,0,0">
                        <TextBlock x:Name="ProfileLabel" Foreground="{DynamicResource MutedTextBrush}" FontSize="12" />
                        <ComboBox x:Name="ProfileCombo" Margin="0,8,0,0" SelectionChanged="ProfileCombo_SelectionChanged" />
                    </StackPanel>

                    <StackPanel Grid.Row="2" Margin="0,20,0,0">
                        <TextBlock x:Name="ModeLabel" Foreground="{DynamicResource MutedTextBrush}" FontSize="12" />
                        <ComboBox x:Name="ModeCombo" Margin="0,8,0,0" SelectionChanged="ModeCombo_SelectionChanged" />
                        <TextBlock x:Name="ModeSummaryText" Margin="0,8,0,0" Foreground="{DynamicResource MutedTextBrush}" FontSize="12" TextWrapping="Wrap" />
                    </StackPanel>

                    <StackPanel Grid.Row="4">
                        <TextBlock x:Name="OutputLabel" Foreground="{DynamicResource MutedTextBrush}" FontSize="12" />
                        <TextBlock x:Name="OutputText" Margin="0,6,0,0" Text="—" TextTrimming="CharacterEllipsis" />
                        <TextBlock x:Name="OutputHintText" Margin="0,5,0,18" Foreground="{DynamicResource MutedTextBrush}" FontSize="12" />
                        <Button x:Name="BlendButton" Style="{StaticResource PrimaryButtonStyle}" Click="BlendButton_Click" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock x:Name="StatusText" Foreground="{DynamicResource MutedTextBrush}" VerticalAlignment="Center" />
                <ProgressBar x:Name="ProcessingProgress" Width="160" Height="6" Margin="16,0,10,0" Visibility="Collapsed" />
                <Button x:Name="CancelButton" Padding="12,6" Visibility="Collapsed" Click="CancelButton_Click" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                <TextBlock x:Name="LanguageLabel" Foreground="{DynamicResource MutedTextBrush}" VerticalAlignment="Center" Margin="0,0,8,0" />
                <ComboBox x:Name="LanguageCombo" Width="126" SelectionChanged="LanguageCombo_SelectionChanged" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
