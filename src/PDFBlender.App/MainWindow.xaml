<ui:FluentWindow x:Class="PDFBlender.App.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:local="clr-namespace:PDFBlender.App"
                 Title="PDF Blender"
                 Icon="/PDFBlender.App;component/Assets/logo.ico"
                 Width="820" Height="600" MinWidth="760" MinHeight="540"
                 WindowStartupLocation="CenterScreen"
                 WindowBackdropType="Mica"
                 WindowCornerPreference="Round"
                 ExtendsContentIntoTitleBar="True"
                 Background="{DynamicResource WindowBackgroundBrush}"
                 TextElement.FontFamily="{DynamicResource AppFontFamily}"
                 UseLayoutRounding="True"
                 SnapsToDevicePixels="True">
    <Grid Background="{DynamicResource WindowBackgroundBrush}"
          TextElement.FontFamily="{DynamicResource AppFontFamily}"
          TextElement.FontSize="13"
          UseLayoutRounding="True"
          SnapsToDevicePixels="True">
        <Grid.RowDefinitions>
            <RowDefinition Height="44" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <ui:TitleBar x:Name="ShellTitleBar" Grid.Row="0" Title="PDF Blender" Height="44" Padding="12,0" Background="{DynamicResource ShellChromeBrush}" Foreground="{DynamicResource TitleTextBrush}" FontFamily="{DynamicResource AppFontFamily}">
            <ui:TitleBar.Icon>
                <ui:ImageIcon Source="/PDFBlender.App;component/Assets/logo.ico" Width="16" Height="16" />
            </ui:TitleBar.Icon>
        </ui:TitleBar>
        <Grid Grid.Row="1" Background="{DynamicResource SidebarBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="72" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <ui:NavigationView Grid.Column="0" x:Name="ShellNavigationView"
                               PaneDisplayMode="LeftFluent"
                               IsPaneOpen="False"
                               IsPaneToggleVisible="False"
                               IsFooterSeparatorVisible="False"
                               CompactPaneLength="72"
                               OpenPaneLength="72"
                               FrameMargin="0"
                               IsBackButtonVisible="Collapsed"
                               Width="72"
                               HorizontalAlignment="Left"
                               Margin="0"
                               Focusable="False"
                               KeyboardNavigation.IsTabStop="False"
                               FocusVisualStyle="{x:Null}"
                               SelectionChanged="NavigationView_SelectionChanged"
                               Transition="FadeInWithSlide"
                               TransitionDuration="320"
                               Background="{DynamicResource SidebarBrush}"
                               ClipToBounds="False"
                               TextElement.FontFamily="{DynamicResource AppFontFamily}"
                               TextElement.FontSize="12">
                <ui:NavigationView.MenuItems>
                    <ui:NavigationViewItem x:Name="HomeNavigationItem" Content="Home" Tag="home" Style="{StaticResource BlenderNavigationItemStyle}" Click="NavigationItem_Click" Loaded="NavigationItem_Loaded" SizeChanged="NavigationItem_SizeChanged" Focusable="True" KeyboardNavigation.IsTabStop="True" AutomationProperties.Name="Home">
                        <ui:NavigationViewItem.Icon><ui:SymbolIcon Symbol="Home24" FontSize="24" /></ui:NavigationViewItem.Icon>
                    </ui:NavigationViewItem>
                    <ui:NavigationViewItem x:Name="ConfigurationNavigationItem" Content="Configuration" Tag="configuration" Style="{StaticResource BlenderNavigationItemStyle}" Click="NavigationItem_Click" Loaded="NavigationItem_Loaded" SizeChanged="NavigationItem_SizeChanged" Focusable="True" KeyboardNavigation.IsTabStop="True" AutomationProperties.Name="Configuration">
                        <ui:NavigationViewItem.Icon><ui:SymbolIcon Symbol="Options24" FontSize="24" /></ui:NavigationViewItem.Icon>
                    </ui:NavigationViewItem>
                </ui:NavigationView.MenuItems>
                <ui:NavigationView.FooterMenuItems>
                    <ui:NavigationViewItem x:Name="SettingsNavigationItem" Content="Settings" Tag="settings" Style="{StaticResource BlenderNavigationItemStyle}" Click="NavigationItem_Click" Loaded="NavigationItem_Loaded" SizeChanged="NavigationItem_SizeChanged" Focusable="True" KeyboardNavigation.IsTabStop="True" AutomationProperties.Name="Settings">
                        <ui:NavigationViewItem.Icon><ui:SymbolIcon Symbol="Settings24" FontSize="24" /></ui:NavigationViewItem.Icon>
                    </ui:NavigationViewItem>
                </ui:NavigationView.FooterMenuItems>
            </ui:NavigationView>
            <Border Grid.Column="1" Background="{DynamicResource WindowBackgroundBrush}" CornerRadius="12,0,0,0" ClipToBounds="True">
                <Grid>
                    <Frame x:Name="ContentFrame" NavigationUIVisibility="Hidden" Margin="0" />
                    <local:UiNotificationHost x:Name="AppNotificationHost" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,16,20,0" />
                </Grid>
            </Border>
        </Grid>
        <ui:ContentDialogHost x:Name="RootDialogHost" Grid.RowSpan="2" Panel.ZIndex="100" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" IsDisableSiblingsEnabled="True" />
    </Grid>
</ui:FluentWindow>
