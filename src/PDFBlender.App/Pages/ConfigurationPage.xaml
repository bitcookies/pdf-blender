<Page x:Class="PDFBlender.App.Pages.ConfigurationPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:local="clr-namespace:PDFBlender.App">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="24,20,24,24" MaxWidth="760">
            <TextBlock x:Name="TitleText" Style="{StaticResource PageTitleTextStyle}" />
            <TextBlock x:Name="SubtitleText" Style="{StaticResource PageDescriptionTextStyle}" Margin="0,3,0,14" />
            <TextBlock x:Name="SlotsHeader" Style="{StaticResource SectionTitleTextStyle}" />
            <TextBlock x:Name="SlotsHint" Style="{StaticResource SmallMutedTextStyle}" Margin="0,3,0,10" />
            <Grid x:Name="SlotsPanel" />
            <Border Margin="0,16,0,0" Padding="24,24" Height="220" Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="14">
                <local:BlendLevelRail x:Name="ConfigurationBlendLevelRail" SelectionChanged="ConfigurationBlendLevelRail_SelectionChanged" />
            </Border>
            <Separator Margin="0,18,0,16" />
            <Grid Margin="0,0,0,8">
                <TextBlock x:Name="ConfigurationsHeader" Style="{StaticResource SectionTitleTextStyle}" />
                <ui:Button x:Name="AddButton" HorizontalAlignment="Right" Padding="12,6" Click="AddButton_Click">
                    <StackPanel Orientation="Horizontal"><ui:SymbolIcon Symbol="Add24" Margin="0,0,6,0" /><TextBlock x:Name="AddButtonText" /></StackPanel>
                </ui:Button>
            </Grid>
            <TextBlock x:Name="EmptyText" Style="{StaticResource SmallMutedTextStyle}" Margin="0,0,0,8" />
            <UniformGrid x:Name="ConfigurationCardsPanel" Columns="3" />
            <TextBlock x:Name="ErrorText" Foreground="{DynamicResource AccentBrush}" TextWrapping="Wrap" Margin="0,10,0,0" />
        </StackPanel>
    </ScrollViewer>
</Page>
