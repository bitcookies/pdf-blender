<Page x:Class="PDFBlender.App.Pages.ConfigurationEditorPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:local="clr-namespace:PDFBlender.App"
>

    <ScrollViewer x:Name="EditorScroller" local:ScrollBarAutoHideBehavior.Enabled="True" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" VerticalContentAlignment="Top" HorizontalContentAlignment="Stretch">
        <Grid Margin="24,20,24,24" MaxWidth="760" VerticalAlignment="Top">
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
            <ui:BreadcrumbBar x:Name="BreadcrumbBar" ItemClicked="BreadcrumbBar_ItemClicked" Margin="0,0,0,12" Cursor="Hand" FontSize="13" FontWeight="Normal" Foreground="#333333">
                <ui:BreadcrumbBar.Resources>
                    <SolidColorBrush x:Key="BreadcrumbBarNormalForegroundBrush" Color="#333333" />
                    <SolidColorBrush x:Key="BreadcrumbBarHoverForegroundBrush" Color="#909090" />
                    <SolidColorBrush x:Key="BreadcrumbBarCurrentNormalForegroundBrush" Color="#333333" />
                    <Style TargetType="{x:Type ui:BreadcrumbBarItem}" BasedOn="{StaticResource DefaultUiBreadcrumbBarItemStyle}">
                        <Setter Property="FontSize" Value="13" />
                        <Setter Property="FontWeight" Value="Normal" />
                        <Setter Property="Icon">
                            <Setter.Value>
                                <ui:IconSourceElement>
                                    <ui:SymbolIconSource Symbol="ChevronRight24" FontSize="12" FontWeight="Normal" />
                                </ui:IconSourceElement>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ui:BreadcrumbBar.Resources>
            </ui:BreadcrumbBar>
            <StackPanel Grid.Row="1">
                <TextBlock x:Name="TitleText" Style="{StaticResource PageTitleTextStyle}" />
                <ui:Card Padding="16,14" Margin="0,12,0,10">
                    <StackPanel>
                        <TextBlock x:Name="NameLabel" Text="配置名" VerticalAlignment="Top" Margin="0,0,0,5" />
                        <ui:TextBox x:Name="NameBox" AutomationProperties.Name="Configuration name" />
                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <TextBlock x:Name="ColorText" Text="颜色" VerticalAlignment="Top" Margin="0,0,14,0" />
                            <UniformGrid x:Name="ColorPanel" Grid.Column="1" Columns="16" Rows="2" />
                        </Grid>
                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <TextBlock x:Name="IconText" Text="图标" VerticalAlignment="Top" Margin="0,0,14,0" />
                            <ui:Button x:Name="IconButton" Grid.Column="1" Appearance="Secondary" Height="38" MinWidth="180" HorizontalAlignment="Left" Click="IconButton_Click" Cursor="Hand" />
                        </Grid>
                    </StackPanel>
                </ui:Card>
                <TextBlock x:Name="ErrorText" Foreground="{DynamicResource AccentBrush}" TextWrapping="Wrap" Margin="0,0,0,8" />
            </StackPanel>
            <StackPanel x:Name="FeaturePanel" Grid.Row="2" />
            <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                <ui:Button x:Name="CancelButton" Appearance="Secondary" Content="Cancel" Click="CancelButton_Click" Margin="0,0,8,0" Cursor="Hand" />
                <ui:Button x:Name="SaveButton" Appearance="Primary" Background="{DynamicResource AccentBrush}" BorderBrush="{DynamicResource AccentBrush}" Foreground="{DynamicResource AccentTextBrush}" Content="Save" Click="SaveButton_Click" Cursor="Hand" />
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>
