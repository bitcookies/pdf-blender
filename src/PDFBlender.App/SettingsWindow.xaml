<Window x:Class="PDFBlender.App.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PDF Blender"
        Width="520"
        Height="590"
        MinWidth="460"
        MinHeight="520"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBackgroundBrush}">
    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock x:Name="TitleText" FontSize="23" FontWeight="SemiBold" />
        <ScrollViewer Grid.Row="1" Margin="0,24,0,20" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <CheckBox x:Name="NormalizeWidthCheck" Margin="0,0,0,18" />
                <TextBlock x:Name="TargetWidthLabel" Foreground="{DynamicResource MutedTextBrush}" FontSize="12" />
                <TextBox x:Name="TargetWidthText" Margin="0,7,0,18" />

                <TextBlock x:Name="ProtectionLabel" Foreground="{DynamicResource MutedTextBrush}" FontSize="12" />
                <ComboBox x:Name="ProtectionCombo" Margin="0,7,0,18" />

                <TextBlock x:Name="WatermarkLabel" Foreground="{DynamicResource MutedTextBrush}" FontSize="12" />
                <ComboBox x:Name="WatermarkCombo" Margin="0,7,0,18" />

                <TextBlock x:Name="WatermarkTextLabel" Foreground="{DynamicResource MutedTextBrush}" FontSize="12" />
                <TextBox x:Name="WatermarkTextBox" Margin="0,7,0,18" />

                <TextBlock x:Name="NoiseLabel" Foreground="{DynamicResource MutedTextBrush}" FontSize="12" />
                <ComboBox x:Name="NoiseCombo" Margin="0,7,0,8" />
                <TextBlock x:Name="ErrorText" Foreground="{DynamicResource AccentBrush}" TextWrapping="Wrap" />
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="CancelButton" Margin="0,0,10,0" Click="CancelButton_Click" />
            <Button x:Name="SaveButton" Style="{StaticResource PrimaryButtonStyle}" Click="SaveButton_Click" />
        </StackPanel>
    </Grid>
</Window>
