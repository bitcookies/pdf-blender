<Project ToolsVersion="15.0" DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup Label="Globals">
    <ProjectGuid>{7F70C0F0-1D8A-4B0C-9C19-3D7C0A5D6F10}</ProjectGuid>
    <RootNamespace>PDFBlender.Package</RootNamespace>
    <MinimumVisualStudioVersion>17.0</MinimumVisualStudioVersion>
    <TargetPlatformVersion>10.0.22621.0</TargetPlatformVersion>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <TargetFrameworkVersion>v4.7.2</TargetFrameworkVersion>
    <DefaultLanguage>en-US</DefaultLanguage>
  </PropertyGroup>
  <Import Project="$(VSToolsPath)\DotNet\Microsoft.DotNet.Props" Condition="'$(VSToolsPath)' != '' And Exists('$(VSToolsPath)\DotNet\Microsoft.DotNet.Props')" />
  <Import Project="$(MSBuildExtensionsPath)\Microsoft\DesktopBridge\Microsoft.DesktopBridge.props" Condition="Exists('$(MSBuildExtensionsPath)\Microsoft\DesktopBridge\Microsoft.DesktopBridge.props')" />
  <PropertyGroup>
    <AppxPackageSigningEnabled>false</AppxPackageSigningEnabled>
    <AppxBundle>Always</AppxBundle>
    <AppxBundlePlatforms>x86|x64|ARM64</AppxBundlePlatforms>
    <AppxPackageDir>$(MSBuildThisFileDirectory)..\publish\installer\</AppxPackageDir>
    <GenerateAppInstallerFile>false</GenerateAppInstallerFile>
    <AppxSymbolPackageEnabled>false</AppxSymbolPackageEnabled>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\src\PDFBlender.App\PDFBlender.App.csproj">
      <ReferenceOutputAssembly>false</ReferenceOutputAssembly>
      <SkipGetTargetFrameworkProperties>true</SkipGetTargetFrameworkProperties>
    </ProjectReference>
  </ItemGroup>
  <ItemGroup>
    <Content Include="Package.appxmanifest" />
    <Content Include="..\assets\logo.png">
      <Link>Assets\StoreLogo.png</Link>
    </Content>
    <Content Include="..\assets\logo.png">
      <Link>Assets\Square44x44Logo.png</Link>
    </Content>
    <Content Include="..\assets\logo.png">
      <Link>Assets\Square150x150Logo.png</Link>
    </Content>
    <Content Include="..\assets\logo.png">
      <Link>Assets\Square310x310Logo.png</Link>
    </Content>
    <Content Include="..\assets\banner.png">
      <Link>Assets\Wide310x150Logo.png</Link>
    </Content>
  </ItemGroup>
  <Import Project="$(MSBuildExtensionsPath)\Microsoft\DesktopBridge\Microsoft.DesktopBridge.targets" Condition="Exists('$(MSBuildExtensionsPath)\Microsoft\DesktopBridge\Microsoft.DesktopBridge.targets')" />
</Project>
