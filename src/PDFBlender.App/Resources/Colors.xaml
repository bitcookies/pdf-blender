    <SolidColorBrush x:Key="TitleTextBrush" Color="#5E5E5E" />
    <SolidColorBrush x:Key="MutedTextBrush" Color="#666666" />
    <SolidColorBrush x:Key="AccentBrush" Color="#D84F58" />
