<Page x:Class="PDFBlender.App.Pages.ConfigurationEditorPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:local="clr-namespace:PDFBlender.App"
>
    <Page.Resources>
        <LinearGradientBrush x:Key="EditorSaveBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="{DynamicResource AccentButtonStartColor}" Offset="0" />
            <GradientStop Color="{DynamicResource AccentButtonEndColor}" Offset="1" />
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="EditorSaveHoverBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="{DynamicResource AccentButtonHoverStartColor}" Offset="0" />
            <GradientStop Color="{DynamicResource AccentButtonHoverEndColor}" Offset="1" />
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="EditorSaveDisabledBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="{DynamicResource AccentButtonDisabledStartColor}" Offset="0" />
            <GradientStop Color="{DynamicResource AccentButtonDisabledEndColor}" Offset="1" />
        </LinearGradientBrush>
        <Style x:Key="EditorSaveButtonStyle" TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ui:Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ContentPresenter Content="{TemplateBinding Content}"
                                              ContentTemplate="{TemplateBinding ContentTemplate}"
                                              ContentStringFormat="{TemplateBinding ContentStringFormat}"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              Margin="{TemplateBinding Padding}" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="Appearance" Value="Transparent" />
            <Setter Property="Background" Value="{StaticResource EditorSaveBrush}" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Padding" Value="14,8" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource EditorSaveHoverBrush}" />
                    <Setter Property="Foreground" Value="White" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="{StaticResource EditorSaveHoverBrush}" />
                    <Setter Property="Foreground" Value="White" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="{StaticResource EditorSaveDisabledBrush}" />
                    <Setter Property="Foreground" Value="{DynamicResource DisabledTextBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </Page.Resources>

    <ScrollViewer x:Name="EditorScroller" local:ScrollBarAutoHideBehavior.Enabled="True" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" VerticalContentAlignment="Top" HorizontalContentAlignment="Stretch">
        <Grid Margin="24,20,24,24" MaxWidth="760" VerticalAlignment="Top">
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
            <ui:BreadcrumbBar x:Name="BreadcrumbBar" ItemClicked="BreadcrumbBar_ItemClicked" Margin="0,0,0,12" Cursor="Hand" FontSize="13" FontWeight="Normal" Foreground="{DynamicResource BreadcrumbBarNormalForegroundBrush}">
                <ui:BreadcrumbBar.Resources>
                    <Style TargetType="{x:Type ui:BreadcrumbBarItem}" BasedOn="{StaticResource DefaultUiBreadcrumbBarItemStyle}">
                        <Setter Property="FontSize" Value="13" />
                        <Setter Property="FontWeight" Value="Normal" />
                        <Setter Property="Icon">
                            <Setter.Value>
                                <ui:IconSourceElement>
                                    <ui:SymbolIconSource Symbol="ChevronRight24" FontSize="12" FontWeight="Normal" />
                                </ui:IconSourceElement>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ui:BreadcrumbBar.Resources>
            </ui:BreadcrumbBar>
            <StackPanel Grid.Row="1">
                <TextBlock x:Name="TitleText" Style="{StaticResource PageTitleTextStyle}" />
                <ui:Card Padding="16,14" Margin="0,12,0,10">
                    <StackPanel>
                        <TextBlock x:Name="NameLabel" Text="配置名" VerticalAlignment="Top" Margin="0,0,0,5" />
                        <ui:TextBox x:Name="NameBox" AutomationProperties.Name="Configuration name" />
                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <TextBlock x:Name="ColorText" Text="颜色" VerticalAlignment="Top" Margin="0,0,14,0" />
                            <UniformGrid x:Name="ColorPanel" Grid.Column="1" Columns="16" Rows="2" />
                        </Grid>
                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <TextBlock x:Name="IconText" Text="图标" VerticalAlignment="Top" Margin="0,0,14,0" />
                            <ui:Button x:Name="IconButton" Grid.Column="1" Appearance="Secondary" Height="38" MinWidth="180" HorizontalAlignment="Left" Click="IconButton_Click" Cursor="Hand" />
                        </Grid>
                    </StackPanel>
                </ui:Card>
                <TextBlock x:Name="ErrorText" Foreground="{DynamicResource AccentBrush}" TextWrapping="Wrap" Margin="0,0,0,8" />
            </StackPanel>
            <StackPanel x:Name="FeaturePanel" Grid.Row="2" />
            <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                <ui:Button x:Name="CancelButton" Appearance="Secondary" Content="Cancel" Click="CancelButton_Click" Margin="0,0,8,0" Cursor="Hand" />
                <ui:Button x:Name="SaveButton" Style="{StaticResource EditorSaveButtonStyle}" Content="Save" Click="SaveButton_Click" Cursor="Hand" />
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>
