<ui:FluentWindow x:Class="PDFBlender.App.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="PDF Blender"
                 Icon="/PDFBlender.App;component/Assets/logo.ico"
                 Width="960" Height="680" MinWidth="860" MinHeight="600"
                 WindowStartupLocation="CenterScreen"
                 ExtendsContentIntoTitleBar="True">
    <Grid Background="{DynamicResource WindowBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <ui:TitleBar x:Name="ShellTitleBar" Grid.Row="0" Title="PDF Blender" Icon="/PDFBlender.App;component/Assets/logo.png" />
        <Grid Grid.Row="1">
        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
        <ui:NavigationView x:Name="ShellNavigation" Grid.Column="0" PaneDisplayMode="Left" IsPaneOpen="True"
                           OpenPaneLength="204" CompactPaneLength="56" IsBackButtonVisible="Collapsed"
                           IsPaneToggleVisible="False" Background="Transparent">
            <ui:NavigationView.MenuItems>
                <ui:NavigationViewItem x:Name="HomeNavigationItem" Content="Home" Tag="home" Click="HomeNavigationItem_Click">
                    <ui:NavigationViewItem.Icon><ui:SymbolIcon Symbol="Home24" /></ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>
                <ui:NavigationViewItem x:Name="SettingsNavigationItem" Content="Settings" Tag="settings" Click="SettingsNavigationItem_Click">
                    <ui:NavigationViewItem.Icon><ui:SymbolIcon Symbol="Settings24" /></ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>
            </ui:NavigationView.MenuItems>
            <ui:NavigationView.FooterMenuItems>
                <ui:NavigationViewItem x:Name="AboutNavigationItem" Content="About" Tag="about" Click="AboutNavigationItem_Click">
                    <ui:NavigationViewItem.Icon><ui:SymbolIcon Symbol="Info24" /></ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>
            </ui:NavigationView.FooterMenuItems>
        </ui:NavigationView>
        <Frame x:Name="ContentFrame" Grid.Column="1" NavigationUIVisibility="Hidden" />
        </Grid>
    </Grid>
</ui:FluentWindow>
