<UserControl x:Class="PDFBlender.App.BlendLevelRail"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             MinHeight="82">
    <UserControl.Resources>
        <Style x:Key="BlendSliderStyle" TargetType="Slider">
            <Setter Property="Height" Value="28" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid Height="28">
                            <Border Height="5" Background="{DynamicResource BorderBrush}" CornerRadius="3" VerticalAlignment="Center" Margin="8,0" />
                            <Track x:Name="PART_Track" VerticalAlignment="Center">
                                <Track.DecreaseRepeatButton><RepeatButton Command="{x:Static Slider.DecreaseLarge}" Background="Transparent" BorderThickness="0" IsTabStop="False" /></Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Width="20" Height="20" FocusVisualStyle="{x:Null}">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border x:Name="ThumbBorder" Background="{DynamicResource AccentBrush}" BorderBrush="{DynamicResource CardBrush}" BorderThickness="3" CornerRadius="10" />
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ThumbBorder" Property="Background" Value="{DynamicResource AccentDarkBrush}" /></Trigger>
                                                    <Trigger Property="IsDragging" Value="True"><Setter TargetName="ThumbBorder" Property="Background" Value="{DynamicResource AccentDarkBrush}" /></Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton><RepeatButton Command="{x:Static Slider.IncreaseLarge}" Background="Transparent" BorderThickness="0" IsTabStop="False" /></Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="28" />
            <RowDefinition Height="28" />
        </Grid.RowDefinitions>

        <Grid>
            <TextBlock x:Name="CaptionText"
                       FontSize="12"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource MutedTextBrush}" />
            <StackPanel HorizontalAlignment="Right" MaxWidth="330">
                <TextBlock x:Name="SelectionText"
                           HorizontalAlignment="Right"
                           FontSize="12"
                           Foreground="{DynamicResource AccentBrush}"
                           FontWeight="SemiBold" />
                <TextBlock x:Name="SelectionSummaryText"
                           HorizontalAlignment="Right"
                           Foreground="{DynamicResource MutedTextBrush}"
                           FontSize="11"
                           TextTrimming="CharacterEllipsis" />
            </StackPanel>
        </Grid>

        <Slider x:Name="LevelSlider"
                Grid.Row="1"
                Style="{StaticResource BlendSliderStyle}"
                Minimum="0"
                Maximum="2"
                TickFrequency="1"
                IsSnapToTickEnabled="True"
                VerticalAlignment="Center"
                AutomationProperties.Name="Blend level"
                ValueChanged="LevelSlider_ValueChanged" />

        <UniformGrid x:Name="LabelsPanel"
                     Grid.Row="2"
                     Columns="3"
                     HorizontalAlignment="Stretch" />
    </Grid>
</UserControl>
