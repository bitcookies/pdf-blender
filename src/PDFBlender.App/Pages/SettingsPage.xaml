<Page x:Class="PDFBlender.App.Pages.SettingsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="22,20,22,24" MaxWidth="760">
            <TextBlock x:Name="TitleText" Style="{StaticResource PageTitleTextStyle}" />
            <TextBlock x:Name="SubtitleText" Style="{StaticResource PageDescriptionTextStyle}" />
            <TextBlock x:Name="AppearanceHeader" Style="{StaticResource SectionTitleTextStyle}" />
            <Border Background="{DynamicResource SettingItemBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="7" Padding="12" Margin="0,0,0,12">
                <Grid MinHeight="72">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="220" /></Grid.ColumnDefinitions>
                    <ui:SymbolIcon Symbol="Color24" FontSize="22" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" Margin="0,0,16,0" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock x:Name="ThemeLabel" FontSize="15" FontWeight="SemiBold" /><TextBlock x:Name="ThemeHint" Style="{StaticResource SmallMutedTextStyle}" /></StackPanel>
                    <ComboBox x:Name="ThemeOptions" Grid.Column="2" VerticalAlignment="Center" SelectionChanged="ThemeOptions_SelectionChanged" />
                </Grid>
            </Border>
            <Border Background="{DynamicResource SettingItemBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="7" Padding="12">
                <Grid MinHeight="72">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="220" /></Grid.ColumnDefinitions>
                    <ui:SymbolIcon Symbol="LocalLanguage24" FontSize="22" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" Margin="0,0,16,0" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock x:Name="LanguageLabel" FontSize="15" FontWeight="SemiBold" /><TextBlock x:Name="LanguageHint" Style="{StaticResource SmallMutedTextStyle}" /></StackPanel>
                    <ComboBox x:Name="LanguageOptions" Grid.Column="2" VerticalAlignment="Center" SelectionChanged="LanguageOptions_SelectionChanged" />
                </Grid>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
