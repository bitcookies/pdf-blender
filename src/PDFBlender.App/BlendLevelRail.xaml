<UserControl x:Class="PDFBlender.App.BlendLevelRail"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             MinHeight="78">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="12" />
            <RowDefinition Height="28" />
        </Grid.RowDefinitions>

        <Grid>
            <TextBlock x:Name="CaptionText"
                       FontSize="12"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource MutedTextBrush}" />
            <StackPanel HorizontalAlignment="Right" MaxWidth="330">
                <TextBlock x:Name="SelectionText"
                           HorizontalAlignment="Right"
                           FontSize="12"
                           Foreground="{DynamicResource AccentBrush}"
                           FontWeight="SemiBold" />
                <TextBlock x:Name="SelectionSummaryText"
                           HorizontalAlignment="Right"
                           Foreground="{DynamicResource MutedTextBrush}"
                           FontSize="11"
                           TextTrimming="CharacterEllipsis" />
            </StackPanel>
        </Grid>

        <Slider x:Name="LevelSlider"
                Grid.Row="1"
                Height="22"
                Minimum="0"
                Maximum="2"
                TickFrequency="1"
                IsSnapToTickEnabled="True"
                VerticalAlignment="Center"
                AutomationProperties.Name="Blend level"
                ValueChanged="LevelSlider_ValueChanged" />

        <UniformGrid x:Name="LabelsPanel"
                     Grid.Row="2"
                     Columns="3"
                     HorizontalAlignment="Stretch" />
    </Grid>
</UserControl>
